[Unit]
Description=Stream Deck herdr/agent dashboard
Documentation=https://github.com/yasarmahomedabbas/dotfiles
# Ordering only — the daemon waits for the deck on its own, and reads hc while the
# herdr window is closed, so an unplugged deck or closed window just means it idles.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# ~/.local/bin holds herdr-app / hc / board / theme-switch; the rest live in /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/streamdeck-dashboard/venv/bin/python %h/.local/bin/streamdeck-dashboard
Restart=on-failure
RestartSec=3
# Only signal the daemon on stop/restart, never the whole cgroup: a herdr window it
# opened must survive. spawn() also puts it in its own scope via systemd-run.
KillMode=process

[Install]
WantedBy=graphical-session.target
