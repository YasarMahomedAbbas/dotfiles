# ─────────────────────────────────────────────────────────────────────────────


def sh(*args, **kw):
    """Run a command, return CompletedProcess; never raises."""
    try:
        return subprocess.run(args, capture_output=True, text=True, **kw)
    except Exception:
        return subprocess.CompletedProcess(args, 1, "", "")


def spawn(*args):
    """Fire-and-forget launch of a long-lived GUI process (the herdr window).

    In its OWN transient systemd scope, so the window lives outside this service's
    cgroup and survives a restart of the dashboard. Falls back to a detached Popen."""
    if shutil.which("systemd-run"):
        args = ("systemd-run", "--user", "--scope", "--quiet", "--collect", *args)
    try:
        subprocess.Popen(args, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        log("spawn failed:\n" + traceback.format_exc())


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


# ── theme ────────────────────────────────────────────────────────────────────
def _hex(s):
    s = s.strip().strip('"').strip("'").lstrip("#")
    return (int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16))


def load_theme():
    """Status colours (docs/agent-board.md §4) from ~/.config/theme/sesh-colors.sh,
    which theme-switch rewrites; re-read every poll so a switch shows at once."""
    vals = {}
    try:
        text = (Path.home() / ".config/theme/sesh-colors.sh").read_text()
    except OSError:
        return
    for line in text.splitlines():
        k, eq, v = line.strip().removeprefix("export ").partition("=")
        if eq:
            vals[k.strip()] = v.strip().strip('"').strip("'")
    fzf = dict(p.split(":", 1) for p in vals.get("SESH_FZF_COLORS", "").split(",") if ":" in p)
    roles = {
        "alert": vals.get("SESH_ATTN_COLOR"),
        "slow": vals.get("SESH_BUSY_COLOR"),
        "done": vals.get("SESH_OK_COLOR"),
        "accent": vals.get("SESH_ACCENT_COLOR"),
        "busy": vals.get("SESH_FG0_COLOR") or fzf.get("fg+"),
        "background": vals.get("SESH_BLUE_COLOR") or fzf.get("prompt"),
    }
    for role, h in roles.items():
        if h:
            try:
                COLORS[role] = _hex(h)
            except ValueError:
                pass
    COLORS["on"] = COLORS["alert"]


def name_color(name, default=None):
    """The colour for a project's or machine's name (NAME_COLORS), else `default`."""
    c = NAME_COLORS.get((name or "").lower())
    if c == "accent":
        return COLORS["accent"]
    try:
        return _hex(c) if c else default or COLORS["text"]
    except ValueError:
        return default or COLORS["text"]


def theme_names():
    return [t.strip() for t in sh("theme-switch", "--names").stdout.splitlines() if t.strip()]


def active_theme():
    try:
        return (Path.home() / ".config/theme/active").read_text().strip()
    except OSError:
        return ""


@lru_cache(maxsize=1)
def _palettes_dir():
    """<repo>/themes/palettes, resolved the same way theme-switch does."""
    root = os.environ.get("DOTFILES")
    if not root:
        ts = shutil.which("theme-switch")
        if not ts:
            return None
        root = Path(os.path.realpath(ts)).parents[3]   # <repo>/bin/.local/bin/theme-switch
    d = Path(root) / "themes" / "palettes"
    return d if d.is_dir() else None


@lru_cache(maxsize=None)
def theme_palette(name):
    """A palette .env as {role: 'rrggbb'} (empty if not found)."""
    pal, d = {}, _palettes_dir()
    if not d:
        return pal
    try:
        for line in (d / f"{name}.env").read_text().splitlines():
            k, eq, v = line.strip().partition("=")
            if eq and not k.startswith("#"):
                pal[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return pal


# ── audio + media ────────────────────────────────────────────────────────────
def muted(target):
    return "MUTED" in sh("wpctl", "get-volume", target).stdout


def toggle_mute(target):
    sh("wpctl", "set-mute", target, "toggle")


MIC, SINK = "@DEFAULT_AUDIO_SOURCE@", "@DEFAULT_AUDIO_SINK@"


def player_playing():
    return sh("playerctl", "status").stdout.strip() == "Playing"


def volume(delta):
    sh("wpctl", "set-volume", "-l", "1.5", SINK, delta)


# ── herdr state ──────────────────────────────────────────────────────────────
# A space is {id, name, machine, active, agents, status}; agents are the terminals
# that run a coding agent, most urgent first: {terminal, status, entry}.
# status is one of these, most urgent first (herdr's own order: blocked > done >
# working > idle, with working split by the board into slow / busy / background).
RANK = {"alert": 0, "done": 1, "slow": 2, "busy": 3, "background": 4, "idle": 5}
ACTIVE = ("alert", "slow", "busy", "background")


def herdr_ls():
    """The open window's spaces (`herdr-app ls`), or None when the window is closed."""
    r = sh("herdr-app", "ls", timeout=5)
    if r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return None
    return data.get("spaces") if isinstance(data, dict) else None


def hc_spaces():
    """Window closed: rebuild the spaces from hc's live terminals, whose `where` is
    "space / tab". No ids, so a press resolves the space by name once herdr is up."""
    r = sh("hc", "ls", "--json", timeout=5)
    try:
        terms = json.loads(r.stdout).get("terminals") or []
    except (ValueError, AttributeError):
        return []
    spaces = {}
    for t in terms:
        if t.get("state") != "live" or " / " not in (t.get("where") or ""):
            continue
        name, tab = t["where"].split(" / ", 1)
        status = t.get("status")
        if isinstance(status, dict):
            status = status.get("state")
        s = spaces.setdefault(name, {"id": None, "name": name, "machine": None,
                                     "active": False, "tabs": []})
        s["tabs"].append({"name": tab, "terminals": [
            {"terminal": t.get("address"), "status": status, "app": t.get("agent") if status else None}]})
    return list(spaces.values())


def board_entries():
    """`board list --json`: every Claude session, most urgent first (docs/agent-board.md)."""
    r = sh("board", "list", "--json", timeout=8)
    try:
        data = json.loads(r.stdout) if r.returncode == 0 else []
    except ValueError:
        return []
    return [e for e in data if isinstance(e, dict) and not e.get("stale")]


def hc_terminal(pid):
    """The hc terminal a process runs in (its HC_TERMINAL_ID), or None. This is how a
    board entry, which knows its Claude's pid, is matched to herdr's terminal."""
    try:
        env = Path(f"/proc/{int(pid)}/environ").read_bytes()
    except (OSError, TypeError, ValueError):
        return None
    for kv in env.split(b"\0"):
        if kv.startswith(b"HC_TERMINAL_ID="):
            return kv[15:].decode() or None
    return None


def agent_status(herdr_status, entry):
    """herdr's status for the terminal, refined by its board entry (slow, background);
    the board alone when herdr has none."""
    e = entry or {}
    if not herdr_status and e:
        herdr_status = {"needs_you": "blocked", "working": "working"}.get(e.get("state")) \
            or ("done" if e.get("unseen") else "idle")
    if herdr_status in ("blocked", "error"):
        return "alert"
    if herdr_status == "working":
        cur = e.get("current") or {}
        typ, started = cur.get("typical_ms"), cur.get("started")
        return "slow" if typ and started and time.time() * 1000 - started > typ else "busy"
    if e.get("state") == "background":
        return "background"
    return "done" if herdr_status == "done" else "idle"


def load_state():
    """(spaces, window open?, board entries) — one herdr read and one board read."""
    raw = herdr_ls()
    window = raw is not None
    if raw is None:
        raw = hc_spaces()
    entries = board_entries()
    by_terminal = {}
    for e in entries:
        t = hc_terminal(e.get("pid"))
        if t:
            by_terminal.setdefault(t, e)
    spaces, seq = [], 0
    for s in raw:
        agents = []
        for tab in s.get("tabs") or []:
            for t in tab.get("terminals") or []:
                e = by_terminal.get(t.get("terminal"))
                if t.get("app") or t.get("status") or e:
                    agents.append({"terminal": t.get("terminal"), "entry": e,
                                   "space": s.get("name") or "", "tab": tab.get("name") or "",
                                   "shown": window and bool(s.get("active") and tab.get("active")),
                                   "status": agent_status(t.get("status"), e), "seq": seq})
                    seq += 1
        agents.sort(key=lambda a: RANK[a["status"]])   # stable: tab order within a rank
        spaces.append({"id": s.get("id"), "name": s.get("name") or "", "machine": s.get("machine"),
                       "active": window and bool(s.get("active")), "agents": agents,
                       "status": agents[0]["status"] if agents else "idle"})
    return spaces, window, entries


def pick(items, n):
    """Up to n spaces or agents, kept in herdr's order. With more than n, the ones
    that want you (needs you, then finished) are guaranteed a key before busy and idle
    ones — a glance is meant to say who needs you."""
    if len(items) <= n:
        return items
    tier = {"alert": 0, "done": 1, "idle": 3}
    keep = sorted(range(len(items)), key=lambda i: (tier.get(items[i]["status"], 2), i))[:n]
    return [items[i] for i in sorted(keep)]


def newest_design(entries):
    """The newest design canvas's board key across sessions, or None."""
    best_at, best_key = None, None
    for e in entries:
        for d in e.get("designs") or []:
            if d.get("url") and (best_at is None or (d.get("at") or 0) > best_at):
                best_at, best_key = d.get("at") or 0, e.get("key")
    return best_key


def project_paths():
    """{space name: folder} for the WORK page, as herdr's sessions picker builds it."""
    out = {}
    herd = read_json(PROJECT_FILES[0], {}) or {}
    for name, p in herd.items():
        if isinstance(p, dict) and p.get("root") and not name.startswith("//"):
            out[name.lower()] = p["root"].rstrip("/") + ("/" + p["workdir"] if p.get("workdir") else "")
    for p in (read_json(PROJECT_FILES[1], {}) or {}).get("projects") or []:
        if p.get("name") and p.get("path"):
            out[p["name"].lower()] = p["path"]
    return {k: os.path.expanduser(v) for k, v in out.items()}


# ── herdr actions ────────────────────────────────────────────────────────────
def herdr_do(cmd, **args):
    r = sh("herdr-app", "do", cmd, json.dumps(args), timeout=10)
    if r.returncode != 0:
        log(f"herdr-app do {cmd} failed: {(r.stdout or r.stderr).strip()}")
    return r.returncode == 0


def present(action):
    """Run `action` against the herdr window and bring it to the front — opening the
    window first when it's closed (hc kept the terminals running). On a thread, so a
    slow window start never freezes the deck."""
    def go():
        if herdr_ls() is None:
            spawn("herdr-app")
            deadline = time.time() + 15
            while herdr_ls() is None and time.time() < deadline:
                time.sleep(0.3)
        try:
            action()
        finally:
            sh("hyprctl", "dispatch", f'hl.dsp.focus({{ window = "class:{HERDR_CLASS}" }})')
    threading.Thread(target=go, daemon=True).start()


def select_space(match):
    """Show the first open space for which match(space) is true; False if none."""
    for s in herdr_ls() or []:
        if match(s):
            return herdr_do("space.select", id=s["id"])
    return False


def by_name(name):
    return lambda s: (s.get("name") or "").lower() == name.lower()


def open_space(space):
    """Main-page press: show the space's most urgent agent that's doing anything, or
    just the space (keeping whichever tab it had) when all its agents are idle."""
    top = next((a for a in space["agents"] if a["status"] != "idle"), None)
    if top and top["terminal"]:
        present(lambda: herdr_do("agent.focus", terminal=top["terminal"]))
    else:
        present(lambda: select_space(by_name(space["name"])))


def open_agent(agent):
    """Agents-page press: show that agent; the page stays up."""
    present(lambda: herdr_do("agent.focus", terminal=agent["terminal"]))


def open_project(name):
    """WORK press: show the project's space, or open one in its folder with claude
    running (what herdr's sessions picker does)."""
    def act():
        if not select_space(by_name(name)):
            args = {"name": name, "argv": ["claude"], "machine": ""}
            folder = project_paths().get(name.lower())
            if folder:
                args["folder"] = folder
            else:
                log(f"no folder for project {name!r} in {', '.join(map(str, PROJECT_FILES))}")
            herdr_do("space.new", **args)
    present(act)


def open_machine(machine, label):
    """VPS press: show a space on that hc machine, or open one."""
    present(lambda: select_space(lambda s: s.get("machine") == machine)
            or herdr_do("space.new", name=label, machine=machine))


def open_picker():
    present(lambda: herdr_do("mod.open", name=PICKER_MOD))


# ── rendering ────────────────────────────────────────────────────────────────
@lru_cache(maxsize=None)
def font(size):
    for query in ("JetBrainsMono Nerd Font:bold", "monospace:bold"):
        p = sh("fc-match", "-f", "%{file}", query).stdout.strip()
        if p:
            try:
                return ImageFont.truetype(p, size)
            except OSError:
                pass
    return ImageFont.load_default()


@lru_cache(maxsize=None)
def load_logo(size, filename):
    """A logo scaled to fit the key, or None if it's missing."""
    try:
        img = Image.open(LOGO_DIR / filename).convert("RGBA")
    except Exception:
        return None
    box = int(min(size) * 0.62)
    img.thumbnail((box, box), Image.LANCZOS)
    return img


def _canvas(deck, bg):
    w, h = deck.key_image_format()["size"]
    img = bg if isinstance(bg, Image.Image) else Image.new("RGB", (w, h), bg)
    return img, ImageDraw.Draw(img), w, h


def _done(deck, img):
    return PILHelper.to_native_key_format(deck, img)


def _border(d, w, h, color, width=4, inset=0):
    if color:
        d.rectangle([inset, inset, w - 1 - inset, h - 1 - inset], outline=color, width=width)


def _fit(draw, text, f, maxw):
    """Truncate to fit maxw, with an ellipsis when it doesn't."""
    if draw.textlength(text, font=f) <= maxw:
        return text
    while text and draw.textlength(text + "…", font=f) > maxw:
        text = text[:-1]
    return (text + "…") if text else ""


def _sized(draw, text, sizes, maxw):
    """The largest font in `sizes` that fits text in maxw (else the smallest)."""
    for fs in sizes:
        if draw.textlength(text, font=font(fs)) <= maxw:
            return font(fs)
    return font(sizes[-1])


def _gradient(w, h, rgb, top=0.30, bottom=0.03):
    """Diagonal fade from a tint of the status colour to near-black."""
    img = Image.new("RGB", (w, h))
    px = img.load()
    for y in range(h):
        for x in range(w):
            k = top + (bottom - top) * ((x + y) / (w + h - 2))
            px[x, y] = tuple(int(4 + c * k) for c in rgb)
    return img


def _strip(d, x0, y0, w, h, cells):
    """A row of progress cells: 'd' done, 'r' running, 's' slow, 'a' needs you, '' ahead."""
    if not cells:
        return
    gap = 1 if 2 * len(cells) - 1 <= w else 0   # long task lists drop the gaps
    cw = (w - gap * (len(cells) - 1)) / len(cells)
    for i, c in enumerate(cells):
        x = x0 + i * (cw + gap)
        box = [round(x), y0, max(round(x), round(x + cw) - 1), y0 + h - 1]
        if c == "a":
            d.rectangle(box, outline=COLORS["alert"], width=1)
        else:
            fill = {"d": COLORS["done"], "r": COLORS["busy"], "s": COLORS["slow"]}.get(c, (52, 55, 60))
            d.rectangle(box, fill=fill)


def _draw_wrapped(draw, text, size, fill, fontsize, minsize=10, y0=0):
    """Draw text centred in `size`, shrinking it to stay on one line before wrapping;
    a wrap prefers a separator (issue-559 → "issue- / 559") over a mid-word break."""
    w, h = size
    avail = w - 8
    for fs in range(fontsize, minsize - 1, -1):
        if draw.textlength(text, font=font(fs)) <= avail:
            draw.text((w / 2, y0 + h / 2), text, font=font(fs), fill=fill, anchor="mm")
            return
    f = font(minsize)
    head = next((text[:i] for i in range(len(text), 0, -1)
                 if text[i - 1] in "-_ ./" and draw.textlength(text[:i], font=f) <= avail), "")
    if head:
        lines = [head.rstrip(), text[len(head):]]
    else:
        lines, cur = [], ""
        for ch in text:
            if draw.textlength(cur + ch, font=f) <= avail:
                cur += ch
            else:
                lines.append(cur)
                cur = ch
        lines.append(cur)
    lines = [_fit(draw, ln, f, avail) for ln in lines[:2] if ln]
    y = y0 + (h - len(lines) * (minsize + 2)) / 2 + minsize / 2
    for ln in lines:
        draw.text((w / 2, y), ln, font=f, fill=fill, anchor="mm")
        y += minsize + 2


def _short_label(label):
    """Fit a status label to a key: stage names shortened, and of an escalation label
    `<kind> · <stage>` keep the kind (what is being asked) when both won't fit."""
    parts = [STAGE_SHORT.get(p.strip(), p.strip()) for p in (label or "").split("·")]
    short = " · ".join(p for p in parts if p)
    return short if len(short) <= 16 else parts[0]


def _elapsed(ms):
    """Epoch-ms start → 'm:ss' / 'h:mmh' since then; '' when unknown."""
    if not ms:
        return ""
    s = max(0, int(time.time() - ms / 1000))
    return f"{s // 3600}:{s % 3600 // 60:02d}h" if s >= 3600 else f"{s // 60}:{s % 60:02d}"


def _ago(ms):
    if not ms:
        return ""
    m = max(0, int(time.time() - ms / 1000)) // 60
    return f"{m}m ago" if m < 60 else f"{m // 60}h ago"


def space_card(space):
    """A main-page space key: its most urgent agent's card, titled with the space."""
    agents = space["agents"]
    return card(space["name"], space["status"], (agents[0]["entry"] if agents else None) or {},
                more=sum(a["status"] in ACTIVE for a in agents),
                done_n=sum(a["status"] == "done" for a in agents))


def agent_card(agent):
    """An agents-page key: one agent, titled by its ticket, else its tab's name (herd
    names tabs "#2219 stored flight dates"), else its space."""
    e = agent["entry"] or {}
    issue = (e.get("ticket") or {}).get("issue")
    tab = agent["tab"]
    generic = not tab or tab.isdigit() or tab in ("shell", "claude")
    title = f"#{issue}" if issue else agent["space"] if generic else tab
    return card(title, agent["status"], e, color_of=agent["space"], logo=False)


def card(title, status, e, more=0, done_n=1, color_of=None, logo=True):
    """What a status key shows, as plain data (also its render signature):
    (title, status, detail, timer, issue, stages, tasks, more, title colour). A quiet
    key (finished or idle) has no timer and its detail is the band label."""
    t = e.get("ticket") or {}
    stage = STAGE_SHORT.get(t.get("stage"), t.get("stage") or "")
    issue = f"#{t['issue']}" if t.get("issue") else ""
    if issue and title.startswith(issue):
        issue = ""
    stages = tasks = ()
    detail, timer = "", ""

    if status == "alert":
        a = e.get("attention") or {}
        detail = a.get("title") or {"permission": "permission", "plan": "plan"}.get(a.get("kind"), "needs you")
        timer = _elapsed(a.get("since") or e.get("since")) or "!"
    elif status in ("busy", "slow"):
        cur = e.get("current") or {}
        detail = cur.get("detail") or cur.get("tool") or stage or "working"
        timer = _elapsed(cur.get("started") or e.get("since")) or "…"
    elif status == "background":
        running = [a for a in e.get("agents") or [] if a.get("status") in ("running", "needs_you")]
        shells = [s for s in e.get("shells") or [] if s.get("status") == "running"]
        n, what = (len(running), "agent") if running else (len(shells), "shell")
        detail = f"{n} {what}{'s' if n != 1 else ''}"
        starts = [x.get("started") for x in running + shells if x.get("started")]
        timer = _elapsed(min(starts)) if starts else "…"
    elif status == "done":
        detail = f"✓ {done_n} done" if done_n > 1 else f"✓ {_ago(e.get('finished_at')) or 'done'}"
    elif logo:
        detail = stage
    else:   # agents page: always say so, rather than leave a bare title
        idle = _ago(e.get("since")).removesuffix(" ago")
        detail = f"idle {idle}" if idle else "idle"

    if timer:   # the strips only on an active card
        now = {"alert": "a", "slow": "s"}.get(status, "r")
        si, stot = t.get("stage_index"), t.get("stage_total")
        if si and stot:
            stages = tuple("d" if i < si else now if i == si else "" for i in range(1, stot + 1))
        td, tt = t.get("tasks_done"), t.get("tasks_total")
        if tt and td is not None and td < tt:
            tasks = tuple("d" if i < td else "r" if i == td else "" for i in range(tt))
    return (title, status, _short_label(detail), timer, issue, stages, tasks, more,
            name_color(color_of or title, (241, 244, 247)), logo)


def render_space(deck, card, attached, pulse):
    name, status, detail, timer, issue, stages, tasks, more, ncol, logo = card
    col = COLORS[status]
    w, h = deck.key_image_format()["size"]
    tint = COLORS["idle"] if status == "idle" else col
    img, d, w, h = _canvas(deck, _gradient(w, h, tint, top=0.34 if status == "alert" else 0.24))
    if timer:
        _draw_card(d, w, h, name, ncol, status, detail, timer, issue, stages, tasks, more)
    else:
        _draw_quiet(img, d, w, h, name, ncol, status, detail, logo)
    if status == "alert":
        a = COLORS["alert"]
        _border(d, w, h, a if pulse else tuple(int(c * 0.55) for c in a), width=3)
    if attached:
        _border(d, w, h, COLORS["attach"], width=2, inset=1)
    return _done(deck, img)


def _draw_card(d, w, h, name, ncol, status, detail, timer, issue, stages, tasks, more):
    """An active space: name (and ×N when several agents are busy), what its most
    urgent agent wants or does, a ticking timer with the ticket number, then the
    stage strip and, while implementing, the task strip."""
    col, pad, bright = COLORS[status], 6, (241, 244, 247)
    badge = f"×{more}" if more > 1 else ""
    bw = d.textlength(badge, font=font(10)) + 3 if badge else 0
    f = _sized(d, name, (13, 12, 11, 10), w - 2 * pad - bw)
    d.text((pad, pad - 1), _fit(d, name, f, w - 2 * pad - bw), font=f, fill=ncol, anchor="la")
    if badge:
        d.text((w - pad, pad), badge, font=font(10), fill=COLORS["textdim"], anchor="ra")

    dcol = (200, 206, 214) if status == "busy" else col
    d.text((pad, 21), _fit(d, detail, font(9), w - 2 * pad), font=font(9), fill=dcol, anchor="la")

    strips = [s for s in (tasks, stages) if s]
    bottom = h - pad - (len(strips) * 6 + max(0, len(strips) - 1) * 3)
    tf = font(17) if len(timer) <= 5 else font(14)
    d.text((pad, bottom - 3), timer, font=tf, fill=bright if status == "busy" else col, anchor="lb")
    if issue and d.textlength(timer, font=tf) + d.textlength(issue, font=font(9)) + 4 <= w - 2 * pad:
        d.text((w - pad, bottom - 4), issue, font=font(9), fill=COLORS["textdim"], anchor="rb")
    y = bottom + 2
    for s in strips:
        _strip(d, pad, y, w - 2 * pad, 5, s)
        y += 8


def _draw_quiet(img, d, w, h, name, ncol, status, label, logos=True):
    """A finished or idle key: its logo (or name) and a band with the label — under
    the logo on the main page; on top on the agents page (logos=False), where it's
    the first thing to read."""
    band = 18 if label else 0
    top = 0 if logos else band              # where the name area starts
    logo = load_logo((w, h - band), SPACE_LOGOS[name.lower()]) if logos and name.lower() in SPACE_LOGOS else None
    if logo:
        img.paste(logo, ((w - logo.width) // 2, (h - band - logo.height) // 2), logo)
    else:
        _draw_wrapped(d, name, (w, h - band), ncol, 15, minsize=9, y0=top)
    if label:
        by = h - band if logos else 0       # band's top edge
        d.rectangle([0, by, w, by + band], fill=tuple(int(c * 0.45) for c in COLORS[status]))
        f = _sized(d, label, (11, 10, 9), w - 6)
        fill = COLORS["done"] if status == "done" else COLORS["text"]
        d.text((w / 2, by + band / 2), _fit(d, label, f, w - 6), font=f, fill=fill, anchor="mm")


def render_action(deck, glyph, label, color=None, border=None):
    img, d, w, h = _canvas(deck, COLORS["action"])
    d.text((w / 2, h * 0.40), glyph, font=font(30), fill=color or COLORS["text"], anchor="mm")
    d.text((w / 2, h * 0.82), label, font=font(12), fill=COLORS["textdim"], anchor="mm")
    _border(d, w, h, border, width=3)
    return _done(deck, img)


def render_blank(deck):
    return _done(deck, _canvas(deck, COLORS["empty"])[0])


def render_launcher(deck, label, logo_file, glyph, accent, border, label_color=None):
    """A WORK / VPS key: its logo (or the glyph in the theme accent) above the label,
    bordered by its space's state."""
    img, d, w, h = _canvas(deck, COLORS["action"])
    logo = load_logo((w, h), logo_file) if logo_file else None
    if logo:
        img.paste(logo, ((w - logo.width) // 2, int(h * 0.42 - logo.height / 2)), logo)
    else:
        d.text((w / 2, h * 0.40), glyph or G_SERVER, font=font(30), fill=accent, anchor="mm")
    d.text((w / 2, h * 0.86), label, font=_sized(d, label, (12, 11, 10), w - 8),
           fill=label_color or COLORS["textdim"], anchor="mm")
    _border(d, w, h, border)
    return _done(deck, img)


def render_theme(deck, name, active):
    """A theme key in the theme's own colours: its bg0, and the icon and name in its
    accent; an accent border on the active one."""
    pal = theme_palette(name)
    accent = _hex(pal.get("accent", "88c0d0"))
    img, d, w, h = _canvas(deck, _hex(pal.get("bg0", "1b1f27")))
    d.text((w / 2, h * 0.36), G_EYEDROP, font=font(28), fill=accent, anchor="mm")
    parts = name.split("-")   # "vscode-dark" reads as two tidy lines
    lines = (parts if len(parts) <= 2 else [parts[0], "-".join(parts[1:])])[:2]
    y = h * 0.74 - len(lines) * 15 / 2 + 7.5
    for ln in lines:
        d.text((w / 2, y), ln, font=font(13), fill=accent, anchor="mm")
        y += 15
    if active:
        _border(d, w, h, accent)
    return _done(deck, img)


def space_border(space):
    """WORK / VPS border: the shown space, else its agents' state, else open-but-quiet."""
    if not space:
        return None
    if space["active"]:
        return COLORS["attach"]
    return COLORS[space["status"]] if space["status"] in ACTIVE else COLORS["live"]


# ── dashboard ────────────────────────────────────────────────────────────────
class Dashboard:
    """Each refresh asks the current page for its keys — {key: (signature, render)} —
    and its presses — {key: fn}. Keys a page leaves out are blanked, and a key is only
    redrawn when its signature changed."""

    def __init__(self, deck):
        self.deck = deck
        self.lock = threading.RLock()
        self.cache = {}       # key -> signature of what's on it
        self.press = {}       # key -> fn, for the page on screen
        self.view = "main"

    def goto(self, view):
        return lambda: setattr(self, "view", view)

    def refresh(self):
        with self.lock:
            keys, press = {}, {}

            def put(key, render, *args, on=None):
                keys[key] = ((render.__name__, *args), partial(render, self.deck, *args))
                if on:
                    press[key] = on

            getattr(self, f"page_{self.view}")(put)
            if self.view != "main":
                put(BACK_KEY, render_action, G_BACK, "BACK", on=self.goto("main"))
            self.press = press
            for key in range(self.deck.key_count()):
                sig, render = keys.get(key) or (("blank",), partial(render_blank, self.deck))
                if self.cache.get(key) != sig:
                    self.deck.set_key_image(key, render())
                    self.cache[key] = sig

    def on_press(self, deck, key, pressed):
        if not pressed:
            return
        try:
            fn = self.press.get(key)
            if fn:
                fn()
            self.refresh()    # show the result now rather than on the next poll
        except Exception:
            log("press error:\n" + traceback.format_exc())

    # ── pages ──
    def page_main(self, put):
        spaces, _window, entries = load_state()
        pulse = int(time.time()) % 2 == 0
        for key, s in zip(SPACE_SLOTS, pick(spaces, len(SPACE_SLOTS))):
            put(key, render_space, space_card(s), s["active"], pulse and s["status"] == "alert",
                on=partial(open_space, s))
        put(MEDIA_KEY, render_action, G_MUSIC, "MEDIA", on=self.goto("media"))
        put(WORK_KEY, render_action, G_BRIEFCASE, "WORK", on=self.goto("work"))
        put(AGENTS_KEY, render_action, G_ROBOT, "AGENTS", on=self.goto("agents"))
        put(VPS_KEY, render_action, G_CLOUD, "VPS", on=self.goto("vps"))
        design = newest_design(entries)
        if design:
            put(DESIGN_KEY, render_action, G_BRUSH, "DESIGN", COLORS["accent"], COLORS["accent"],
                on=lambda: sh("board", "design", design))
        else:
            put(DESIGN_KEY, render_action, G_BRUSH, "DESIGN", COLORS["textdim"])
        put(PICK_KEY, render_action, G_SEARCH, "PICK", on=open_picker)
        put(THEME_KEY, render_action, G_EYEDROP, "THEME", on=self.goto("themes"))
        self._mute_key(put, MIC_KEY, MIC, G_MIC, G_MIC_OFF, "MIC")
        self._mute_key(put, MUTE_KEY, SINK, G_VOL, G_VOL_OFF, "MUTE")

    def _mute_key(self, put, key, target, glyph, glyph_off, label):
        m = muted(target)
        put(key, render_action, glyph_off if m else glyph, label, COLORS["on"] if m else None,
            on=partial(toggle_mute, target))

    def page_agents(self, put):
        """Every agent as a card, in herdr's order (space, then tab) so each keeps its
        key while you work; a press shows it and the page stays."""
        agents = sorted((a for s in load_state()[0] for a in s["agents"] if a["terminal"]),
                        key=lambda a: a["seq"])
        pulse = int(time.time()) % 2 == 0
        for key, a in zip(AGENT_SLOTS, pick(agents, len(AGENT_SLOTS))):
            put(key, render_space, agent_card(a), a["shown"], pulse and a["status"] == "alert",
                on=partial(open_agent, a))

    def page_media(self, put):
        playing = player_playing()
        put(1, render_action, G_PREV, "PREV", on=lambda: sh("playerctl", "previous"))
        put(2, render_action, *((G_PAUSE, "PAUSE") if playing else (G_PLAY, "PLAY")),
            on=lambda: sh("playerctl", "play-pause"))
        put(3, render_action, G_NEXT, "NEXT", on=lambda: sh("playerctl", "next"))
        self._mute_key(put, 6, SINK, G_VOL, G_VOL_OFF, "MUTE")
        put(7, render_action, G_VOL_DOWN, "VOL-", on=partial(volume, "5%-"))
        put(8, render_action, G_VOL, "VOL+", on=partial(volume, "5%+"))

    def page_themes(self, put):
        active = active_theme()
        for key, name in zip(PAGE_SLOTS, theme_names()):
            put(key, render_theme, name, name == active, on=partial(sh, "theme-switch", name))

    def page_work(self, put):
        spaces = {s["name"].lower(): s for s in load_state()[0]}
        for key, (name, label, logo, glyph) in zip(PAGE_SLOTS, WORK_PROJECTS):
            put(key, render_launcher, label, logo, glyph, COLORS["accent"],
                space_border(spaces.get(name.lower())), name_color(name, COLORS["textdim"]),
                on=self._then_main(open_project, name))

    def page_vps(self, put):
        spaces = {}
        for s in load_state()[0]:
            if s["machine"]:
                spaces.setdefault(s["machine"], s)
        for key, (machine, label, logo, glyph) in zip(VPS_SLOTS, VPS_HOSTS):
            put(key, render_launcher, label, logo, glyph, COLORS["accent"],
                space_border(spaces.get(machine)), name_color(machine, COLORS["textdim"]),
                on=self._then_main(open_machine, machine, label))

    def _then_main(self, fn, *args):
        def go():
            fn(*args)
            self.view = "main"
        return go


# ── deck lifecycle ───────────────────────────────────────────────────────────
def wait_for_deck(stop):
    """Block until a deck is enumerated (or `stop` is set — then return None)."""
    while not stop.is_set():
        try:
            decks = DeviceManager().enumerate()
        except Exception:
            decks = []
        if decks:
            return decks[0]
        stop.wait(2)
    return None


def open_deck(deck):
    deck.open()
    deck.reset()
    deck.set_brightness(BRIGHTNESS)
    log(f"connected: {deck.deck_type()} ({deck.key_count()} keys)")


def deck_connected(deck):
    try:
        return deck.connected()
    except Exception:
        return False


def reconnect(dash, old, stop):
    """The deck stopped accepting writes (unplugged, resumed, re-enumerated, or a
    wedged handle that still enumerates). Drop the handle and open a fresh one,
    retrying until one opens or `stop` is set."""
    try:
        old.close()
    except Exception:
        pass
    while not stop.is_set():
        deck = wait_for_deck(stop)
        if deck is None:
            return None
        try:
            open_deck(deck)
        except Exception:
            log("reopen failed, retrying:\n" + traceback.format_exc())
            try:
                deck.close()
            except Exception:
                pass
            stop.wait(2)
            continue
        with dash.lock:
            dash.deck = deck
            dash.cache.clear()           # full redraw onto the fresh handle
        deck.set_key_callback(dash.on_press)
        return deck
    return None


def main():
    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())

    load_theme()
    deck = wait_for_deck(stop)
    if deck is None:
        return
    open_deck(deck)
    dash = Dashboard(deck)
    deck.set_key_callback(dash.on_press)

    # A wedged handle can still report connected(), so a few failed polls in a row
    # force a reopen too, not only connected() going false.
    RECONNECT_AFTER = 3
    fails = 0
    try:
        while not stop.is_set():
            try:
                load_theme()
                dash.refresh()
                fails = 0
            except Exception:
                fails += 1
                gone = not deck_connected(deck)
                if gone or fails >= RECONNECT_AFTER:
                    log(f"deck unresponsive ({'disconnected' if gone else f'{fails} failures'}) — reconnecting")
                    deck = reconnect(dash, deck, stop)
                    if deck is None:
                        break
                    fails = 0
                else:
                    log("refresh error:\n" + traceback.format_exc())
            stop.wait(POLL)
    finally:
        with dash.lock:
            try:
                deck.reset()
                deck.close()
            except Exception:
                pass
        log("shut down cleanly")


if __name__ == "__main__":
    main()
