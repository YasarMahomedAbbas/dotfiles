#!/usr/bin/env python3
"""
streamdeck-dashboard — a physical dashboard for the tmux + Claude workflow on a
15-key Stream Deck (MK.2 / Original, 3x5, 72x72px keys).

Top row (keys 0-4): one key per tmux session, background coloured by its most urgent
Claude from the agent board (`board list --json`, docs/agent-board.md §4) — red =
needs you, frost = working, yellow = working past its typical time, steel blue =
background agents, green = finished and unseen, dim slate = idle — over a band
naming what it wants or does ("Results", "build", "2 agents"). The currently-attached
session gets a cyan border. Press a session key to `board jump` to that Claude's pane
(or switch to the session when no Claude runs there). Key 5 (MEDIA) opens the media
page; key 6 (WORK) opens the work (project launcher) page; key 8 (VPS) opens the VPS
page — one key per SSH host, each of which opens a fresh ghostty running `ssh <host>`.
Key 9 (DESIGN) lights in the theme accent when any session has published a design
canvas, and opens the newest one (`board design`).

Bottom row: PICK (sesh popup, key 10) · THEME (picker page, key 11) · MIC (mic
mute, key 13) · MUTE (output mute, key 14). MIC/MUTE reflect live
state. MEDIA opens playerctl transport + volume controls; THEME opens a picker
of the available theme-switch palettes (each key previews its own colours); WORK
opens a launcher of the configured projects (each key shows its logo/glyph and a
border for the session's live state) that create-or-switch via `sesh connect`.

Runs as a systemd user service (streamdeck-dashboard.service). Polls ~1x/s
and only redraws keys whose appearance actually changed, so USB traffic stays low.
The interpreter is the venv at ~/.local/share/streamdeck-dashboard/venv (created
by the install step); the systemd unit points ExecStart at it.
"""

import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import traceback
from functools import lru_cache
from pathlib import Path


def log(*a):
    print("streamdeck-dashboard:", *a, file=sys.stderr, flush=True)

from PIL import Image, ImageDraw, ImageFont
from StreamDeck.DeviceManager import DeviceManager
from StreamDeck.ImageHelpers import PILHelper

# ── config ──────────────────────────────────────────────────────────────────
POLL = 1.0                      # seconds between tmux polls
SESSION_SLOTS = list(range(5))  # keys 0-4 -> sessions (top row only)
MEDIA_KEY = 5                   # key 5 opens the media page (freed middle row)
WORK_KEY = 6                    # key 6 opens the work (projects) page
VPS_KEY = 8                     # key 8 opens the VPS (ssh launcher) page
DESIGN_KEY = 9                  # key 9 opens the newest design canvas (board design)
THEME_KEY = 11                  # THEME action key opens the theme picker page
THEME_SLOTS = list(range(10))   # theme-picker page: keys 0-9 -> themes
THEME_BACK_KEY = 10             # theme-picker page: BACK
WORK_SLOTS = list(range(10))    # work page: keys 0-9 -> projects
WORK_BACK_KEY = 10              # work page: BACK
VPS_SLOTS = [6, 8]              # VPS page: host keys, centred in the middle row
VPS_BACK_KEY = 10               # VPS page: BACK
PICKER_POPUP = ["display-popup", "-E", "-w", "75%", "-h", "75%", "sesh-picker"]

# Work page — one key per project (in this fixed order, for muscle memory). Each
# entry is (session_name, label, logo_file | None, glyph). session_name MUST match
# the sesh.toml session name so a live session is detected and `sesh connect`
# resolves the right config. logo_file (in LOGO_DIR) renders as an image; when it
# is None the glyph is drawn in the theme accent instead.
LOGO_DIR = Path.home() / ".local/share/streamdeck-dashboard/logos"
WORK_PROJECTS = [
    ("dotfiles",    "dotfiles",  None,            ""),  # gear
    ("prepahead",   "prepahead", "prepahead.png", None),
    ("equipx",      "equipx",    "equipx.png",    None),
    ("gegrond",     "gegrond",   "gegrond.png",   None),
    ("travelsmart", "travel",    "travelsmart.png", None),
    ("vault",       "vault",     "vault.png",       None),
]
# Main-page session keys reuse a project's logo (when it has one) instead of the
# session name, keyed by session name — so a running project shows its mark.
SESSION_LOGOS = {name: logo for name, _label, logo, _glyph in WORK_PROJECTS if logo}
GHOSTTY_CLASS = "com.mitchellh.ghostty"

VPS_HOST_GLYPH = ""  # server — per-host key fallback when a host has no logo
# VPS page — one key per SSH host, in this fixed order (muscle memory). Each entry
# is (ssh_alias, label, logo_file | None, glyph). The alias is resolved from
# ~/.ssh/config, so the handler just runs `ssh <alias>`. Pressing a key ALWAYS opens
# a fresh ghostty running that ssh command. logo_file (in LOGO_DIR) renders as an
# image; when it is None the glyph is drawn in the theme accent instead.
VPS_HOSTS = [
    ("hostinger-server", "hostinger", "hostinger.png", None),
    ("stargazer",        "stargazer", "stargazer.png", None),
]

# Fallback palette (Nord-ish); live values pulled from the active theme below.
COLORS = {
    "alert":  (224, 112, 58),   # attn (rust) — needs you
    "busy":   (236, 239, 244),  # fg0 (frost) — working
    "slow":   (235, 203, 139),  # yellow — working past its typical time
    "background": (129, 161, 193),  # blue — turn ended, agents/shells still run
    "done":   (163, 190, 140),  # green — finished since you last looked (unseen)
    "design": (136, 192, 208),  # accent — a design canvas exists
    "idle":   (42, 46, 56),     # dim slate
    "empty":  (12, 13, 16),     # near-black, no session
    "action": (27, 31, 39),     # action-key background
    "attach": (136, 192, 208),  # frost cyan — attached-session border
    "live":   (163, 190, 140),  # green — a running (but unattached) session
    "on":     (191, 97, 106),   # active toggle accent (MUTED)
    "text":   (216, 222, 233),
    "textdim": (120, 130, 150),
}

# Action keys 10-14: (glyph, label, active-state fn, handler fn). Defined after
# the helpers they call; filled in at the bottom of the config section.
# ─────────────────────────────────────────────────────────────────────────────


def sh(*args, **kw):
    """Run a command, return CompletedProcess; never raises."""
    try:
        return subprocess.run(args, capture_output=True, text=True, **kw)
    except Exception:
        return subprocess.CompletedProcess(args, 1, "", "")


def spawn(*args):
    """Fire-and-forget launch of a long-lived GUI process (e.g. ghostty).

    Must NOT use sh()/subprocess.run: those block until the process exits, and a
    terminal we launch stays alive for as long as its window is open — which would
    wedge the key-callback thread and freeze the whole deck.

    Launch it in its OWN transient systemd scope (`systemd-run --user --scope`) so
    the window lives outside this service's cgroup. Otherwise a plain child stays in
    streamdeck-dashboard.service's cgroup and gets SIGTERM'd whenever the service is
    restarted — taking the terminal window (and any tmux client in it) down with it.
    The `--collect` cleans the scope up once the process exits. Fall back to a plain
    detached Popen if systemd-run isn't available."""
    if shutil.which("systemd-run"):
        args = ("systemd-run", "--user", "--scope", "--quiet", "--collect", *args)
    try:
        subprocess.Popen(
            args, start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except Exception:
        log("spawn failed:\n" + traceback.format_exc())


def tmux(*args):
    return sh("tmux", *args)


# ── theme colours (reuse ~/.config/theme/sesh-colors.sh) ─────────────────────
def load_theme():
    """Status colours per docs/agent-board.md §4, from sesh-colors.sh. fg0 / blue were
    added there with the board; until the next theme-switch they come from the fzf
    colour string (fg+ is fg0, prompt is blue)."""
    f = Path.home() / ".config/theme/sesh-colors.sh"
    vals = {}
    try:
        for line in f.read_text().splitlines():
            line = line.strip().removeprefix("export ").strip()
            k, eq, v = line.partition("=")
            if eq:
                vals[k] = v.strip().strip('"').strip("'")
    except FileNotFoundError:
        return
    fzf = dict(p.split(":", 1) for p in vals.get("SESH_FZF_COLORS", "").split(",") if ":" in p)
    roles = {
        "alert": vals.get("SESH_ATTN_COLOR"),
        "slow": vals.get("SESH_BUSY_COLOR"),
        "done": vals.get("SESH_OK_COLOR"),
        "design": vals.get("SESH_ACCENT_COLOR"),
        "busy": vals.get("SESH_FG0_COLOR") or fzf.get("fg+"),
        "background": vals.get("SESH_BLUE_COLOR") or fzf.get("prompt"),
    }
    for role, h in roles.items():
        if h:
            try:
                COLORS[role] = _hex(h)
            except ValueError:
                pass
    COLORS["on"] = COLORS["alert"]


def _hex(s):
    s = s.strip().strip('"').strip("'").lstrip("#")
    return (int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16))


# ── fonts ────────────────────────────────────────────────────────────────────
@lru_cache(maxsize=None)
def font(size):
    for query in ("JetBrainsMono Nerd Font:bold", "monospace:bold"):
        p = sh("fc-match", "-f", "%{file}", query).stdout.strip()
        if p:
            try:
                return ImageFont.truetype(p, size)
            except OSError:
                pass
    return ImageFont.load_default()


# ── tmux state ───────────────────────────────────────────────────────────────
def list_sessions():
    r = tmux("list-sessions", "-F", "#{session_name}")
    return sorted(n for n in r.stdout.splitlines() if n)


def board_entries():
    """`board list --json`: every Claude session, most urgent first (docs/agent-board.md)."""
    r = sh("board", "list", "--json", timeout=8)
    if r.returncode != 0:
        return []
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return []
    return [e for e in data if isinstance(e, dict) and not e.get("stale")]


def _board_label(e):
    """The key band: what the session wants, or what it is doing, in a word or two."""
    st, t = e.get("state"), e.get("ticket") or {}
    if st == "needs_you":
        a = e.get("attention") or {}
        return a.get("title") or a.get("kind") or "needs you"
    if st == "working":
        cur = e.get("current") or {}
        return t.get("stage") or cur.get("tool") or "working"
    if st == "background":
        n = sum(a.get("status") in ("running", "needs_you") for a in e.get("agents") or [])
        return f"{n} agent{'s' if n != 1 else ''}" if n else "shells"
    if e.get("unseen"):
        return "done"
    return t.get("stage") or ""


def _board_status(e):
    st = e.get("state")
    if st == "needs_you":
        return "alert"
    if st == "working":
        cur = e.get("current") or {}
        typ, started = cur.get("typical_ms"), cur.get("started")
        if typ and started and time.time() * 1000 - started > typ:
            return "slow"
        return "busy"
    if st == "background":
        return "background"
    return "done" if e.get("unseen") else "idle"


def session_states(entries=None):
    """{name: (status, label, board_key)} for every tmux session that runs a Claude.

    status is 'alert' | 'busy' | 'slow' | 'background' | 'done' | 'idle'. One
    `board list --json` per poll; the board sorts its entries most-urgent first, so
    the first entry for a session is the one its key shows. Sessions without a Claude
    are simply absent (callers default them to idle)."""
    out = {}
    for e in board_entries() if entries is None else entries:
        name = (e.get("tmux") or {}).get("session")
        if name and name not in out:
            out[name] = (_board_status(e), _board_label(e), e.get("key"), e)
    return out


def newest_design(entries):
    """(board key, design) of the newest design canvas across sessions, or (None, None)."""
    best = (None, None)
    for e in entries:
        for d in e.get("designs") or []:
            if d.get("url") and (best[1] is None or (d.get("at") or 0) > (best[1].get("at") or 0)):
                best = (e.get("key"), d)
    return best


def active_client():
    """Name of the most-recently-active attached client, or None."""
    r = tmux("list-clients", "-F", "#{client_activity} #{client_name}")
    best, best_t = None, -1
    for line in r.stdout.splitlines():
        act, _, cname = line.partition(" ")
        t = int(act) if act.isdigit() else 0
        if t >= best_t and cname:
            best, best_t = cname, t
    return best


def attached_session():
    c = active_client()
    if not c:
        return None
    return tmux("display-message", "-t", c, "-p", "#{session_name}").stdout.strip()


def switch_to(name):
    """Switch the terminal to a session and bring its window to the front.

    Mirrors the work page (open_work): if a tmux client is attached, switch it and
    focus the ghostty window; if nothing is attached anywhere, jump to workspace 1
    and launch ghostty attached to the session."""
    c = active_client()
    if c:
        tmux("switch-client", "-c", c, "-t", name)
        focus_terminal()
    else:
        sh("hyprctl", "dispatch", "hl.dsp.focus({ workspace = 1 })")
        spawn("ghostty", "-e", "sesh", "connect", name)


# ── action handlers + live state ─────────────────────────────────────────────
def open_picker():
    c = active_client()
    if c:
        tmux(*PICKER_POPUP[:1], "-c", c, *PICKER_POPUP[1:])


def theme_names():
    return [t.strip() for t in sh("theme-switch", "--names").stdout.splitlines() if t.strip()]


def active_theme():
    try:
        return (Path.home() / ".config/theme/active").read_text().strip()
    except OSError:
        return ""


@lru_cache(maxsize=1)
def _palettes_dir():
    """<repo>/themes/palettes, resolved the same way theme-switch does."""
    root = os.environ.get("DOTFILES")
    if not root:
        ts = shutil.which("theme-switch")
        if not ts:
            return None
        # <repo>/bin/.local/bin/theme-switch -> repo root is four parents up
        root = Path(os.path.realpath(ts)).parents[3]
    d = Path(root) / "themes" / "palettes"
    return d if d.is_dir() else None


@lru_cache(maxsize=None)
def theme_palette(name):
    """Parse a palette .env into a {role: 'rrggbb'} dict (empty if not found)."""
    pal, d = {}, _palettes_dir()
    if d:
        try:
            for line in (d / f"{name}.env").read_text().splitlines():
                line = line.strip()
                if line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                pal[k.strip()] = v.strip().strip('"').strip("'")
        except OSError:
            pass
    return pal


def mic_muted():
    return "MUTED" in sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@").stdout


def sink_muted():
    return "MUTED" in sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@").stdout


# ── work page (project launcher) ─────────────────────────────────────────────
def has_session(name):
    return tmux("has-session", "-t", f"={name}").returncode == 0


def current_accent():
    """The active theme's accent colour (for glyph-only project keys)."""
    pal = theme_palette(active_theme())
    return _hex(pal["accent"]) if pal.get("accent") else COLORS["attach"]


def focus_terminal():
    """Bring a terminal window to the front (focus any ghostty)."""
    sh("hyprctl", "dispatch", f'hl.dsp.focus({{ window = "class:{GHOSTTY_CLASS}" }})')


def open_work(name):
    """Open a project's tmux session and focus a terminal on it.

    If a terminal (tmux client) is open, `sesh connect -s` creates the session
    when missing — honouring the sesh.toml startup_command — and *switches* the
    most-recently-active client to it (works even though this daemon runs outside
    tmux), then we focus the terminal. If no client is attached anywhere, jump to
    workspace 1 and launch ghostty attached to the session (a fresh TTY, so sesh
    attaches, creating the session first if it doesn't exist)."""
    if active_client():
        sh("sesh", "connect", "-s", name)
        focus_terminal()
    else:
        sh("hyprctl", "dispatch", "hl.dsp.focus({ workspace = 1 })")
        spawn("ghostty", "-e", "sesh", "connect", name)


def open_vps(alias):
    """Always open a fresh ghostty running `ssh <alias>`.

    Unlike the work page (which switches an existing tmux client when one is
    attached), a VPS press unconditionally spawns a new ghostty window per press —
    each SSH session gets its own terminal. The alias is resolved from
    ~/.ssh/config, so ghostty just execs `ssh <alias>`."""
    spawn("ghostty", "-e", "ssh", alias)


@lru_cache(maxsize=None)
def load_logo(size, filename):
    """Load a project logo scaled to fit the key, or None if it's missing."""
    try:
        img = Image.open(LOGO_DIR / filename).convert("RGBA")
    except Exception:
        return None
    box = int(min(size) * 0.62)
    img.thumbnail((box, box), Image.LANCZOS)
    return img


# glyph, label, is-active (or None), on-press
ACTIONS = {
    10: ("", "PICK",  None,        open_picker),
    11: ("", "THEME", None,        None),  # THEME_KEY -> opens the theme picker page
    13: ("", "MIC",   mic_muted,   lambda: sh("wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle")),
    14: ("", "MUTE",  sink_muted,  lambda: sh("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle")),
}
# glyph shown when a toggle is active (muted)
ACTIVE_GLYPH = {13: "", 14: ""}  # mic-slash, volume-off

WORK_GLYPH = "\uf0b1"   # briefcase — main-page key that opens the work page
VPS_GLYPH = ""   # cloud — main-page key that opens the VPS page
# The MEDIA key on the main page (key 5) opens the media page below.
MEDIA_GLYPH = ""  # music note


# ── media page (playerctl transport + wpctl volume) ──────────────────
def player_playing():
    return sh("playerctl", "status").stdout.strip() == "Playing"


def _vol(delta):
    return lambda: sh("wpctl", "set-volume", "-l", "1.5", "@DEFAULT_AUDIO_SINK@", delta)


# key -> (glyph, label, is-active (or None), on-press). The play/pause key (2)
# swaps glyph+label on player status; BACK (10) has a None handler -> main page.
MEDIA_ACTIONS = {
    1: ("", "PREV", None,       lambda: sh("playerctl", "previous")),
    2: ("", "PLAY", None,       lambda: sh("playerctl", "play-pause")),
    3: ("", "NEXT", None,       lambda: sh("playerctl", "next")),
    7: ("", "VOL-", None,       _vol("5%-")),
    8: ("", "VOL+", None,       _vol("5%+")),
    6: ("", "MUTE", sink_muted, lambda: sh("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle")),
    10: ("", "BACK", None,      None),
}
MEDIA_ACTIVE_GLYPH = {6: ""}  # volume-off when muted
# Playing state swaps key 1 to a pause glyph + PAUSE label.
MEDIA_PLAYING = ("", "PAUSE")


# ── rendering ────────────────────────────────────────────────────────────────
def key_size(deck):
    return deck.key_image_format()["size"]


# The six pipeline stages, in the same short vocabulary the sesh picker's rail uses
# (plan · build · review · docs · verify · PR), so the deck and the picker name a stage
# the same way. A 72px key truncates "implement-plan" to "implement-p…", which wastes
# the band on a word you already knew; "build" fits whole.
STAGE_SHORT = {
    "start-ticket": "plan",   "frontend-start-ticket": "plan",
    "implement-plan": "build", "frontend-implement-plan": "build",
    "review": "review",       "frontend-review": "review",
    "doc-drift": "docs",      "frontend-doc-drift": "docs",
    "human-verification": "verify",
    "raise-pr": "PR",         "frontend-raise-pr": "PR",
}


def _short_label(label):
    """Shorten a status label to something that fits a key band.

    An escalation label is `<kind> · <stage>` (see frontend-pipeline's step 5), and the
    kind is the half that says what is actually being asked — so when the whole thing
    won't fit, the stage is what goes."""
    if not label:
        return ""
    parts = [p.strip() for p in label.split("·")]
    parts = [STAGE_SHORT.get(p, p) for p in parts]
    short = " · ".join(p for p in parts if p)
    return short if len(short) <= 16 else parts[0]


def _fit(draw, text, f, maxw):
    """Truncate to fit maxw, with an ellipsis when it doesn't."""
    if draw.textlength(text, font=f) <= maxw:
        return text
    while text and draw.textlength(text + "…", font=f) > maxw:
        text = text[:-1]
    return (text + "…") if text else ""


def render_session(deck, name, status, attached, label=""):
    """A session key: the name (or the project's logo) over a band carrying the
    pipeline stage or Claude's reason for wanting you — 'plan-brief', 'implement-plan',
    'allow Bash?'. The colour already says needs-you / working / done; the band is what
    says *which ticket state*, which is the thing you'd otherwise have to attach to
    find out. Keys are 72x72, so the band is one truncated line and no more."""
    w, h = key_size(deck)
    if name and status == "idle":   # match the Claude keys' dark fade
        img = _gradient(w, h, (90, 95, 105), top=0.24)
    else:
        img = Image.new("RGB", (w, h), COLORS[status if name else "empty"])
    d = ImageDraw.Draw(img)
    label = _short_label(label)
    if name:
        band = 18 if label else 0
        body = (w, h - band)
        logo = load_logo(body, SESSION_LOGOS[name]) if name in SESSION_LOGOS else None
        if logo:
            img.paste(logo, (int((w - logo.width) / 2), int((h - band - logo.height) / 2)), logo)
        else:
            fg = (30, 30, 30) if _light(COLORS[status]) else COLORS["text"]
            _draw_wrapped(d, name, body, fg, 15)
        if label:
            d.rectangle([0, h - band, w, h], fill=_shade(COLORS[status]))
            f = font(11)
            for fs in (11, 10, 9):
                f = font(fs)
                if d.textlength(label, font=f) <= w - 6:
                    break
            d.text((w / 2, h - band / 2), _fit(d, label, f, w - 6), font=f,
                   fill=COLORS["text"], anchor="mm")
    if attached:
        d.rectangle([0, 0, w - 1, h - 1], outline=COLORS["attach"], width=4)
    return PILHelper.to_native_key_format(deck, img)


def _elapsed(ms):
    """Epoch-ms start → 'm:ss' / 'h:mm' since then; '' when unknown."""
    if not ms:
        return ""
    s = max(0, int(time.time() - ms / 1000))
    if s >= 3600:
        return f"{s // 3600}:{s % 3600 // 60:02d}h"
    return f"{s // 60}:{s % 60:02d}"


def _ago(ms):
    if not ms:
        return ""
    m = max(0, int(time.time() - ms / 1000)) // 60
    return f"{m}m ago" if m < 60 else f"{m // 60}h ago"


def _board_card(e, status):
    """What a Claude session key shows, as plain data (also the render-cache signature):
    title, detail line, big timer, and the stage + task strips as cell codes
    ('d' done, 'r' running, 'a' needs you, 's' slow, '' pending)."""
    t = e.get("ticket") or {}
    name = (e.get("tmux") or {}).get("session") or ""
    title = f"#{t['issue']}" if t.get("issue") else name
    st = e.get("state")
    detail, timer = "", ""
    if st == "needs_you":
        a = e.get("attention") or {}
        detail = a.get("title") or {"permission": "permission", "plan": "plan"}.get(a.get("kind"), "needs you")
        timer = _elapsed(a.get("since") or e.get("since"))
    elif st == "working":
        cur = e.get("current") or {}
        detail = cur.get("detail") or cur.get("tool") or STAGE_SHORT.get(t.get("stage"), t.get("stage") or "working")
        timer = _elapsed(cur.get("started") or e.get("since"))
    elif st == "background":
        running = [a for a in e.get("agents") or [] if a.get("status") in ("running", "needs_you")]
        shells = [s for s in e.get("shells") or [] if s.get("status") == "running"]
        n = len(running) or len(shells)
        detail = f"{n} agent{'s' if n != 1 else ''}" if running else f"{n} shell{'s' if n != 1 else ''}"
        starts = [x.get("started") for x in running + shells if x.get("started")]
        timer = _elapsed(min(starts)) if starts else ""
    else:
        detail = "✓ done" if e.get("unseen") else (STAGE_SHORT.get(t.get("stage"), t.get("stage") or "idle"))
        timer = _ago(e.get("finished_at")) if e.get("unseen") else ""

    now_cell = {"alert": "a", "slow": "s"}.get(status, "r" if st in ("working", "background") else "d")
    stages = ()
    si, stot = t.get("stage_index"), t.get("stage_total")
    if si and stot:
        stages = tuple("d" if i < si else now_cell if i == si else "" for i in range(1, stot + 1))
    tasks = ()
    td, tt = t.get("tasks_done"), t.get("tasks_total")
    if tt and td is not None and td < tt:
        tasks = tuple("d" if i < td else "r" if i == td else "" for i in range(tt))
    return title, detail, timer, stages, tasks


def _gradient(w, h, rgb, top=0.30, bottom=0.03):
    """Diagonal fade from a tint of the status colour to near-black, like the mockup keys."""
    img = Image.new("RGB", (w, h))
    px = img.load()
    for y in range(h):
        for x in range(w):
            k = top + (bottom - top) * ((x + y) / (w + h - 2))
            px[x, y] = tuple(int(4 + c * k) for c in rgb)
    return img


def _strip(d, x0, y0, w, h, cells, colors):
    if not cells:
        return
    # Long task lists don't fit 1px cells plus gaps on a 72px key: drop the gaps, and
    # never let a cell collapse below 1px (Pillow rejects x1 < x0).
    gap = 1 if 2 * len(cells) - 1 <= w else 0
    cw = (w - gap * (len(cells) - 1)) / len(cells)
    for i, c in enumerate(cells):
        x = x0 + i * (cw + gap)
        box = [round(x), y0, max(round(x), round(x + cw) - 1), y0 + h - 1]
        if c == "a":
            d.rectangle(box, outline=colors["alert"], width=1)
        else:
            d.rectangle(box, fill={"d": colors["done"], "r": colors["busy"], "s": colors["slow"]}.get(c, (52, 55, 60)))


def render_session_board(deck, card, status, attached, pulse):
    """A session key that runs a Claude, drawn like the agent-board mockup: state-tinted
    gradient, ticket number, what it's doing, a ticking timer, then the six-stage strip
    and (while implementing) the task strip. Needs-you keys get a rose border that
    pulses with the poll."""
    title, detail, timer, stages, tasks = card
    w, h = key_size(deck)
    col = COLORS.get(status, COLORS["idle"])
    tint = col if status not in ("idle",) else (90, 95, 105)
    img = _gradient(w, h, tint, top=0.34 if status == "alert" else 0.24)
    d = ImageDraw.Draw(img)
    pad = 6
    bright = (241, 244, 247)

    f = font(13)
    for fs in (13, 12, 11, 10):
        f = font(fs)
        if d.textlength(title, font=f) <= w - 2 * pad:
            break
    d.text((pad, pad - 1), _fit(d, title, f, w - 2 * pad), font=f, fill=bright, anchor="la")

    dcol = col if status in ("alert", "background", "done", "slow") else COLORS["textdim"]
    if status == "busy":
        dcol = (200, 206, 214)
    d.text((pad, 21), _fit(d, detail, font(9), w - 2 * pad), font=font(9), fill=dcol, anchor="la")

    strips = [s for s in (tasks, stages) if s]
    bottom = h - pad - (len(strips) * 6 + max(0, len(strips) - 1) * 3)
    if timer:
        tf = font(17) if len(timer) <= 5 else font(14)
        tcol = bright if status == "busy" else col if status != "idle" else COLORS["textdim"]
        if status == "done":
            tf, tcol = font(10), COLORS["textdim"]
        d.text((pad, bottom - 3), timer, font=tf, fill=tcol, anchor="lb")

    y = bottom + 2
    for s in strips:
        _strip(d, pad, y, w - 2 * pad, 5, s, COLORS)
        y += 8

    if status == "alert":
        a = COLORS["alert"]
        rim = a if pulse else tuple(int(c * 0.55) for c in a)
        d.rectangle([0, 0, w - 1, h - 1], outline=rim, width=3)
    if attached:
        d.rectangle([1, 1, w - 2, h - 2], outline=COLORS["attach"], width=2)
    return PILHelper.to_native_key_format(deck, img)


def _light(rgb):
    """True for a key background light enough to need dark text (frost, yellow, green)."""
    r, g, b = rgb
    return 0.299 * r + 0.587 * g + 0.114 * b > 150


def _shade(rgb, factor=0.45):
    """Darken a key background for the label band, so the band reads as part of the
    same key rather than a second colour."""
    return tuple(max(0, int(c * factor)) for c in rgb)


def render_action(deck, glyph, label, active):
    w, h = key_size(deck)
    img = Image.new("RGB", (w, h), COLORS["action"])
    d = ImageDraw.Draw(img)
    accent = COLORS["on"] if active else COLORS["text"]
    gy = font(30)
    d.text((w / 2, h * 0.40), glyph, font=gy, fill=accent, anchor="mm")
    d.text((w / 2, h * 0.82), label, font=font(12), fill=COLORS["textdim"], anchor="mm")
    return PILHelper.to_native_key_format(deck, img)


DESIGN_GLYPH = "\uf1fc"  # paint brush


def render_design(deck, has_design):
    """The DESIGN key: the brush in the theme accent (with an accent border) when a
    design canvas exists, dim otherwise."""
    w, h = key_size(deck)
    img = Image.new("RGB", (w, h), COLORS["action"])
    d = ImageDraw.Draw(img)
    col = COLORS["design"] if has_design else COLORS["textdim"]
    d.text((w / 2, h * 0.40), DESIGN_GLYPH, font=font(30), fill=col, anchor="mm")
    d.text((w / 2, h * 0.82), "DESIGN", font=font(12), fill=COLORS["textdim"], anchor="mm")
    if has_design:
        d.rectangle([0, 0, w - 1, h - 1], outline=COLORS["design"], width=3)
    return PILHelper.to_native_key_format(deck, img)


def render_blank(deck):
    w, h = key_size(deck)
    return PILHelper.to_native_key_format(deck, Image.new("RGB", (w, h), COLORS["empty"]))


def render_work(deck, label, logo_file, glyph, accent, live, status, attached):
    """A work-page project key: its logo (or a glyph in the theme accent) above
    the project name. The border shows session state — cyan when it's the client's
    attached session, else rust/amber for Claude alert/busy or green when merely
    running; no border when the session isn't live."""
    w, h = key_size(deck)
    img = Image.new("RGB", (w, h), COLORS["action"])
    d = ImageDraw.Draw(img)
    logo = load_logo((w, h), logo_file) if logo_file else None
    if logo:
        img.paste(logo, (int((w - logo.width) / 2), int(h * 0.42 - logo.height / 2)), logo)
    else:  # no logo file (or it's missing) — fall back to the glyph
        d.text((w / 2, h * 0.40), glyph or "", font=font(30), fill=accent, anchor="mm")
    d.text((w / 2, h * 0.86), label, font=font(12), fill=COLORS["textdim"], anchor="mm")
    if attached:
        border = COLORS["attach"]
    elif live:
        border = COLORS[status] if status in ("alert", "busy", "slow", "background") else COLORS["live"]
    else:
        border = None
    if border:
        d.rectangle([0, 0, w - 1, h - 1], outline=border, width=4)
    return PILHelper.to_native_key_format(deck, img)


THEME_ICON = ""  # eyedropper / colour picker


def render_theme(deck, name, active):
    """A theme key: its own bg0 background, a colour-picker icon and the name in
    the theme's own accent colour, plus an accent border when it's the active one."""
    w, h = key_size(deck)
    pal = theme_palette(name)
    bg = _hex(pal.get("bg0", "1b1f27"))
    accent = _hex(pal.get("accent", "88c0d0"))
    img = Image.new("RGB", (w, h), bg)
    d = ImageDraw.Draw(img)

    d.text((w / 2, h * 0.36), THEME_ICON, font=font(28), fill=accent, anchor="mm")

    # split the name on its hyphen so "vscode-dark" reads as two tidy lines
    parts = name.split("-")
    lines = (parts if len(parts) <= 2 else [parts[0], "-".join(parts[1:])])[:2]
    f = font(13)
    y = h * 0.74 - len(lines) * 15 / 2 + 7.5
    for ln in lines:
        d.text((w / 2, y), ln, font=f, fill=accent, anchor="mm")
        y += 15

    if active:
        d.rectangle([0, 0, w - 1, h - 1], outline=accent, width=4)
    return PILHelper.to_native_key_format(deck, img)


def _draw_wrapped(draw, text, size, fill, fontsize, minsize=10):
    """Draw `text` centred in `size`, shrinking the font to keep it on ONE line
    before resorting to wrapping.

    The per-character wrap this used to do unconditionally split names mid-word at
    the key's width — `issue-559` came out as "issue-5 / 59" and `dotfiles` as
    "dotfile / s", which is harder to read at a glance than the same name two points
    smaller. Try each size down to `minsize` first; only wrap when even the smallest
    won't fit, and then prefer a break at a separator over a mid-word one."""
    w, h = size
    avail = w - 8

    for fs in range(fontsize, minsize - 1, -1):
        f = font(fs)
        if draw.textlength(text, font=f) <= avail:
            draw.text((w / 2, h / 2), text, font=f, fill=fill, anchor="mm")
            return

    fs = minsize
    f = font(fs)
    # Prefer breaking where a human would: at the last separator that still fits.
    head = ""
    for i in range(len(text), 0, -1):
        if text[i - 1] in "-_ ./" and draw.textlength(text[:i], font=f) <= avail:
            head = text[:i]
            break
    if head:
        lines = [head.rstrip(), text[len(head):]]
    else:
        lines, cur = [], ""
        for ch in text:
            if draw.textlength(cur + ch, font=f) <= avail:
                cur += ch
            else:
                lines.append(cur)
                cur = ch
            if len(lines) == 2:
                break
        if cur and len(lines) < 2:
            lines.append(cur)
    lines = [ln for ln in lines[:2] if ln]

    total = len(lines) * (fs + 2)
    y = (h - total) / 2 + fs / 2
    for ln in lines:
        draw.text((w / 2, y), ln, font=f, fill=fill, anchor="mm")
        y += fs + 2


# ── main loop ────────────────────────────────────────────────────────────────
class Dashboard:
    def __init__(self, deck):
        self.deck = deck
        self.lock = threading.Lock()
        self.cache = {}           # key -> signature of last render
        self.session_at = {}      # key -> session name (for press handling)
        self.board_at = {}        # key -> board key of the session's most urgent Claude
        self.design_key = None    # board key owning the newest design (DESIGN key)
        self.theme_at = {}        # key -> theme name (theme-picker page)
        self.work_at = {}         # key -> project session name (work page)
        self.vps_at = {}          # key -> ssh alias (vps page)
        self.view = "main"        # "main" | "media" | "themes" | "work" | "vps"

    def set_key(self, key, signature, render):
        if self.cache.get(key) == signature:
            return
        with self.lock:
            self.deck.set_key_image(key, render())
        self.cache[key] = signature

    def _action(self, key, glyph, label, active):
        self.set_key(key, ("a", glyph, active),
                     lambda g=glyph, l=label, a=active:
                         render_action(self.deck, g, l, a))

    def _blank(self, key):
        self.set_key(key, ("blank",), lambda: render_blank(self.deck))

    def refresh(self):
        # Each view draws all 15 keys (unused ones blanked) so the cache diffs
        # cleanly when switching pages — no stale key art lingers.
        {"media": self._refresh_media,
         "themes": self._refresh_themes,
         "work": self._refresh_work,
         "vps": self._refresh_vps}.get(self.view, self._refresh_main)()

    def _refresh_main(self):
        sessions = list_sessions()
        entries = board_entries()
        states = session_states(entries)
        attached = attached_session()

        # Alphabetical, so a key keeps its position and stays muscle memory. But the
        # whole point of this row is that a glance tells you which agent needs you, so
        # when there are more sessions than slots the alerting ones are guaranteed a
        # place rather than falling off the end of the alphabet.
        if len(sessions) > len(SESSION_SLOTS):
            alerting = [n for n in sessions if states.get(n, ("idle", "", None))[0] == "alert"]
            rest = [n for n in sessions if n not in alerting]
            keep = set(alerting[:len(SESSION_SLOTS)])
            for n in rest:
                if len(keep) >= len(SESSION_SLOTS):
                    break
                keep.add(n)
            sessions = [n for n in sessions if n in keep]

        self.session_at = {}
        self.board_at = {}
        for i, key in enumerate(SESSION_SLOTS):
            name = sessions[i] if i < len(sessions) else None
            self.session_at[key] = name
            status, label, bkey, entry = states.get(name, ("idle", "", None, None)) if name else ("empty", "", None, None)
            self.board_at[key] = bkey
            is_attached = bool(name) and name == attached
            if entry is not None:
                # Claude session: the mockup card. The card data is the signature, so a
                # ticking timer re-draws once a second and nothing else re-draws at all.
                card = _board_card(entry, status)
                pulse = status == "alert" and int(time.time()) % 2 == 0
                self.set_key(key, ("sb", card, status, is_attached, pulse),
                             lambda c=card, s=status, a=is_attached, p=pulse:
                                 render_session_board(self.deck, c, s, a, p))
                continue
            self.set_key(key, ("s", name, status, label, is_attached),
                         lambda n=name, s=status, l=label, a=is_attached:
                             render_session(self.deck, n, s, a, l))
        self._action(MEDIA_KEY, MEDIA_GLYPH, "MEDIA", False)
        self._action(WORK_KEY, WORK_GLYPH, "WORK", False)
        self._action(VPS_KEY, VPS_GLYPH, "VPS", False)
        self.design_key, design = newest_design(entries)
        has = design is not None
        self.set_key(DESIGN_KEY, ("d", has), lambda h=has: render_design(self.deck, h))
        used = set(SESSION_SLOTS) | {MEDIA_KEY, WORK_KEY, VPS_KEY, DESIGN_KEY} | set(ACTIONS)
        for key in range(self.deck.key_count()):
            if key not in used:
                self._blank(key)
        for key, (glyph, label, is_active, _) in ACTIONS.items():
            active = bool(is_active and is_active())
            g = ACTIVE_GLYPH.get(key, glyph) if active else glyph
            self._action(key, g, label, active)

    def _refresh_media(self):
        self.session_at = {}      # no sessions on this page
        playing = player_playing()
        for key, (glyph, label, is_active, _) in MEDIA_ACTIONS.items():
            active = bool(is_active and is_active())
            g = MEDIA_ACTIVE_GLYPH.get(key, glyph) if active else glyph
            if key == 2 and playing:          # play/pause reflects transport state
                g, label = MEDIA_PLAYING
            self._action(key, g, label, active)
        for key in range(self.deck.key_count()):
            if key not in MEDIA_ACTIONS:
                self._blank(key)

    def _refresh_themes(self):
        self.session_at = {}
        self.theme_at = {}
        names = theme_names()
        active = active_theme()
        for i, key in enumerate(THEME_SLOTS):
            name = names[i] if i < len(names) else None
            self.theme_at[key] = name
            if name:
                is_active = name == active
                self.set_key(key, ("t", name, is_active),
                             lambda n=name, a=is_active: render_theme(self.deck, n, a))
            else:
                self._blank(key)
        self._action(THEME_BACK_KEY, MEDIA_ACTIONS[10][0], "BACK", False)
        used = set(THEME_SLOTS) | {THEME_BACK_KEY}
        for key in range(self.deck.key_count()):
            if key not in used:
                self._blank(key)

    def _refresh_work(self):
        self.session_at = {}
        self.work_at = {}
        live = set(list_sessions())
        states = session_states()
        attached = attached_session()
        accent = current_accent()
        for i, key in enumerate(WORK_SLOTS):
            proj = WORK_PROJECTS[i] if i < len(WORK_PROJECTS) else None
            if not proj:
                self.work_at[key] = None
                self._blank(key)
                continue
            name, label, logo_file, glyph = proj
            self.work_at[key] = name
            is_live = name in live
            status = states.get(name, ("idle", "", None))[0] if is_live else "idle"
            is_attached = name == attached
            self.set_key(key, ("w", label, logo_file, glyph, accent, is_live, status, is_attached),
                         lambda l=label, lf=logo_file, g=glyph, a=accent, lv=is_live, s=status, at=is_attached:
                             render_work(self.deck, l, lf, g, a, lv, s, at))
        self._action(WORK_BACK_KEY, MEDIA_ACTIONS[10][0], "BACK", False)
        used = set(WORK_SLOTS) | {WORK_BACK_KEY}
        for key in range(self.deck.key_count()):
            if key not in used:
                self._blank(key)

    def _refresh_vps(self):
        self.session_at = {}
        self.vps_at = {}
        accent = current_accent()
        for i, key in enumerate(VPS_SLOTS):
            host = VPS_HOSTS[i] if i < len(VPS_HOSTS) else None
            if not host:
                self.vps_at[key] = None
                self._blank(key)
                continue
            alias, label, logo_file, glyph = host
            self.vps_at[key] = alias
            # reuse the work-key renderer with no live state (VPS hosts aren't tmux
            # sessions) — just the host's logo (or the glyph in the theme accent) + label.
            self.set_key(key, ("v", label, logo_file, glyph, accent),
                         lambda l=label, lf=logo_file, g=glyph, a=accent:
                             render_work(self.deck, l, lf, g, a, False, "idle", False))
        self._action(VPS_BACK_KEY, MEDIA_ACTIONS[10][0], "BACK", False)
        used = set(VPS_SLOTS) | {VPS_BACK_KEY}
        for key in range(self.deck.key_count()):
            if key not in used:
                self._blank(key)

    def on_press(self, deck, key, pressed):
        if not pressed:
            return
        {"media": self._press_media,
         "themes": self._press_themes,
         "work": self._press_work,
         "vps": self._press_vps}.get(self.view, self._press_main)(key)
        # reflect the result quickly instead of waiting for the next poll
        self.refresh()

    def _press_main(self, key):
        if key == MEDIA_KEY:
            self.view = "media"
        elif key == WORK_KEY:
            self.view = "work"
        elif key == VPS_KEY:
            self.view = "vps"
        elif key == THEME_KEY:
            self.view = "themes"
        elif key == DESIGN_KEY:
            if self.design_key:
                sh("board", "design", self.design_key)
        elif key in ACTIONS:
            ACTIONS[key][3]()
        else:
            name = self.session_at.get(key)
            bkey = self.board_at.get(key)
            if bkey:
                sh("board", "jump", bkey)
            elif name:
                switch_to(name)

    def _press_media(self, key):
        if key not in MEDIA_ACTIONS:  # blank key — ignore
            return
        handler = MEDIA_ACTIONS[key][3]
        if handler is None:           # BACK -> return to main page
            self.view = "main"
        else:
            handler()

    def _press_themes(self, key):
        if key == THEME_BACK_KEY:
            self.view = "main"
        else:
            name = self.theme_at.get(key)
            if name:                  # apply the theme; stay so you can audition
                sh("theme-switch", name)

    def _press_work(self, key):
        if key == WORK_BACK_KEY:
            self.view = "main"
            return
        name = self.work_at.get(key)
        if name:                      # launch/attach the project, then drop to main
            open_work(name)
            self.view = "main"

    def _press_vps(self, key):
        if key == VPS_BACK_KEY:
            self.view = "main"
            return
        alias = self.vps_at.get(key)
        if alias:                     # open a new ghostty ssh session, then drop to main
            open_vps(alias)
            self.view = "main"


def wait_for_deck(stop=None):
    """Block until a deck is enumerated (or `stop` is set — then return None)."""
    while stop is None or not stop.is_set():
        try:
            decks = DeviceManager().enumerate()
        except Exception:
            decks = []
        if decks:
            return decks[0]
        stop.wait(2) if stop is not None else time.sleep(2)
    return None


def open_deck(deck):
    deck.open()
    deck.reset()
    deck.set_brightness(70)
    log(f"connected: {deck.deck_type()} ({deck.key_count()} keys)")


def deck_connected(deck):
    try:
        return deck.connected()
    except Exception:
        return False


def reconnect(dash, old, stop):
    """The deck stopped accepting writes (re-enumerated, unplugged, resumed, or a
    wedged handle). Drop the stale handle and re-open a fresh one so the daemon
    self-heals instead of spinning forever. Retries until it gets a handle it can
    actually open (a wedged deck may still enumerate), or `stop` is set."""
    try:
        old.close()
    except Exception:
        pass
    while not stop.is_set():
        deck = wait_for_deck(stop)
        if deck is None:                 # stopping — no new deck to bind
            return None
        try:
            open_deck(deck)
        except Exception:
            log("reopen failed, retrying:\n" + traceback.format_exc())
            try:
                deck.close()
            except Exception:
                pass
            stop.wait(2)
            continue
        with dash.lock:
            dash.deck = deck
            dash.cache.clear()           # force a full redraw onto the fresh handle
        deck.set_key_callback(dash.on_press)
        return deck
    return None


def main():
    load_theme()

    stop = threading.Event()
    def shutdown(*_):
        stop.set()
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    deck = wait_for_deck(stop)
    if deck is None:
        return
    open_deck(deck)
    dash = Dashboard(deck)
    deck.set_key_callback(dash.on_press)

    # A dead/wedged USB handle surfaces as a write failure in refresh(). `connected()`
    # only checks whether the same USB path still enumerates, so a wedged handle (or a
    # drop-and-return on the same path) still reports connected — hence we also force a
    # reconnect after a few consecutive failures, not just when connected() goes false.
    RECONNECT_AFTER = 3   # consecutive failed polls before forcing a reopen
    fail_streak = 0
    try:
        while not stop.is_set():
            try:
                load_theme()      # pick up theme-switch changes live
                dash.refresh()
                fail_streak = 0
            except Exception:
                fail_streak += 1
                gone = not deck_connected(deck)
                if gone or fail_streak >= RECONNECT_AFTER:
                    why = "disconnected" if gone else f"{fail_streak} write failures"
                    log(f"deck unresponsive ({why}) — reconnecting")
                    deck = reconnect(dash, deck, stop)
                    if deck is None:
                        break
                    fail_streak = 0
                else:
                    log("refresh error:\n" + traceback.format_exc())
            stop.wait(POLL)
    finally:
        with dash.lock:
            try:
                deck.reset()
                deck.close()
            except Exception:
                pass
        log("shut down cleanly")


if __name__ == "__main__":
    main()
