NAME_COLORS = {
    "prepahead":   "#5cc05c",   # leaf green
    "travelsmart": "#e6b84a",   # gold
    "vault":       "#a78bfa",   # obsidian purple
    "equipx":      "#4d94ff",   # blue
    "gegrond":     "#d4b483",   # sand
