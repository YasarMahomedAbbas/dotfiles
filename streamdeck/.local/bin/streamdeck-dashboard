BRIGHTNESS = 70                 # 0-100
SPACE_SLOTS = list(range(5))    # main page: keys 0-4 -> herdr spaces
MEDIA_KEY, WORK_KEY, AGENTS_KEY, VPS_KEY, DESIGN_KEY = 5, 6, 7, 8, 9
PICK_KEY, THEME_KEY, MIC_KEY, MUTE_KEY = 10, 11, 13, 14
BACK_KEY = 10                   # every sub-page: back to the main page
PAGE_SLOTS = list(range(10))    # work + theme pages: keys 0-9
VPS_SLOTS = [6, 8]              # VPS page: centred in the middle row
AGENT_SLOTS = [k for k in range(15) if k != BACK_KEY]   # agents page: 14 cards

HERDR_CLASS = "herdr-app"       # Hyprland window class of the herdr window
PICKER_MOD = "sessions"         # herdr mod opened by PICK (C-f s)

