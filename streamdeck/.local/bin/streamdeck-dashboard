    "alert":      (224, 112, 58),   # attn (rust) — needs you
    "busy":       (236, 239, 244),  # fg0 (frost) — working
    "slow":       (235, 203, 139),  # yellow — working past its typical time
    "background": (129, 161, 193),  # blue — turn ended, agents/shells still run
    "done":       (163, 190, 140),  # green — finished since you last looked
    "accent":     (136, 192, 208),  # theme accent — design key, glyph-only keys
    "idle":       (90, 95, 105),    # tint for idle keys
    "empty":      (12, 13, 16),     # blank key
    "action":     (27, 31, 39),     # action-key background
    "attach":     (136, 192, 208),  # border: the space herdr is showing
    "live":       (163, 190, 140),  # border: an open but quiet space
    "on":         (191, 97, 106),   # active toggle (muted)
    "text":       (216, 222, 233),
