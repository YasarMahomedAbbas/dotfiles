    ("travelsmart", "travel",    "travelsmart.png", None),
    ("vault",       "vault",     "vault.png",       None),
]
SPACE_LOGOS = {name: logo for name, _label, logo, _glyph in WORK_PROJECTS if logo}

# Machines for the VPS page: (hc machine name, label, logo file | None, glyph).
# The name is one from `hc machine ls`; hc holds the ssh details.
VPS_HOSTS = [
    ("hostinger", "hostinger", "hostinger.png", None),
    ("stargazer", "stargazer", "stargazer.png", None),
