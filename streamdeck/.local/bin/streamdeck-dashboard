#!/usr/bin/env python3
"""
streamdeck-dashboard — a physical dashboard for herdr and its coding agents on a
15-key Stream Deck (MK.2 / Original, 3x5, 72x72px keys).

Main page
  keys 0-4  herdr spaces, in herdr's order, coloured by their most urgent agent
            (red needs you · green finished, unseen · frost working · yellow slow ·
            blue background agents · dim idle). Press: herdr shows that agent (or
            the space) and the window comes to the front, opening herdr if closed.
  key 5     MEDIA page (playerctl + wpctl)
  key 6     WORK page: one key per project, opens or shows its space
  key 8     VPS page: one key per hc machine, opens or shows a space on it
  key 9     DESIGN: lit when a session published a design canvas, opens the newest
  key 10    PICK: herdr's sessions picker   key 11 THEME page
  key 13    MIC mute                        key 14 output MUTE

Agent state comes from herdr (`herdr-app ls`, or `hc ls` while the window is closed),
enriched with the agent board (`board list --json`: ticket, stage, timer, designs).
See docs/streamdeck.md.

Runs as streamdeck-dashboard.service from the venv at
~/.local/share/streamdeck-dashboard/venv. Polls ~1x/s and only redraws keys whose
appearance changed, so USB traffic stays low.
"""

import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import traceback
from functools import lru_cache, partial
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont
from StreamDeck.DeviceManager import DeviceManager
from StreamDeck.ImageHelpers import PILHelper


def log(*a):
    print("streamdeck-dashboard:", *a, file=sys.stderr, flush=True)


# ── config ──────────────────────────────────────────────────────────────────
