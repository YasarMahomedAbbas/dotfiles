# Ember — the fire palette from personal-assistant (tokens.css): graphite surfaces
# and one fire accent. The terminal itself is untouched: bg0, opacity, blur, fg1
# and the 16 ANSI slots are dark-nord's, so Ghostty looks exactly as before.
theme_name=ember

# Surfaces — near-black base, then a *visible* grey ramp. These double as the
# powerline-pill / panel backgrounds (starship, waybar, tmux), so they must read
# against bg0 rather than collapse into it.
bg0=0a0b0e
bg1=1a1b1e
bg2=232428
bg3=393b3e

# Text — Snow Storm kept; muted brightened so it stays legible on black
fg0=f1f4f7
fg1=d8dee9
fg2=7d858e

# Accents — fire for identity; muted steel replaces bright blue; rose/sage/amber for status
accent=e0703a
accent2=c95f2c
blue=8fa8c8
teal=e5b567
red=ff6b85
orange=e8804d
yellow=e5b567
green=8fc79a
purple=b48ead
# Needs you (agent board): rust in every theme, so "waiting on you" never reads as an error
attn=e0703a

# Misc roles
muted=393b3e
# Readable muted foreground for unfocused tmux panes (legible on near-black)
dim=8a9199

# Terminal surface treatment — slightly less transparent so the black reads as black
opacity=0.85
blur=true

# 16-slot ANSI palette — darker blacks (0/8), Nord accents otherwise
ansi0=1b1f27
ansi1=bf616a
ansi2=a3be8c
ansi3=ebcb8b
ansi4=81a1c1
ansi5=b48ead
ansi6=88c0d0
ansi7=d8dee9
ansi8=3a4150
ansi9=bf616a
ansi10=a3be8c
ansi11=ebcb8b
ansi12=81a1c1
ansi13=b48ead
ansi14=8fbcbb
ansi15=eceff4
