#!/usr/bin/env python3
"""
board — the agent board's CLI: the one reader every display uses.

Contract: docs/agent-board.md. The agent-board Claude mod writes one state file per
Claude process to $BOARD_DIR/<key>.json (default ~/.cache/claude-board); this reads
them, drops stale ones, enriches each and acts on them.

  board list [--json]            sessions, needs_you > working > background > unseen > idle
  board summary [--json]         counts + the live stack per project
  board pill [#{status}]         tmux status-right counts pill (nothing when all quiet);
                                 with #{status}, keeps the second line on while any
                                 session is open
  board here <session> <width>   tmux status-left: this session's issue, stage, activity
  board pipelines <session> <width>  tmux status line 2: a pill per pipeline
  board roster                   fzf roster (tmux prefix+i)
  board jump <key>               focus Ghostty, switch the tmux client to that pane, mark seen
  board next                     jump to the oldest needs_you session
  board answer <key> <n>         send option n to that pane (only while it is needs_you)
  board stack <key> [--yes]      wt-dev use <worktree> --db auto (dry run without --yes)
  board design <key> [--copy]    open (or wl-copy) the newest design url
  board seen <key|%pane>         mark finished work as seen (tmux pane-focus-in hook)
  board keys [--json]            the board's key table, for the cheatsheet

`<key>` is the state file's name without `.json`: the tmux pane id without `%`
(`%42` -> `42`) or `nopane-<session_id>`. Anywhere a key is taken, `%42` works too.

`board list --json` is consumed by quickshell and streamdeck-dashboard: an array of the
state files exactly as the mod wrote them, each with these fields added:

  key      str    the state file's name (see above)
  stale    bool   heartbeat older than 30 s AND pid gone (shown grey; the file is
                  deleted once its heartbeat is 10 min old)
  unseen   bool   state is idle and `finished_at` is newer than $BOARD_DIR/seen/<key>
                  (touched by `board seen`, and automatically for a pane a tmux client
                  is currently looking at)
  stack    str    the wt-dev dev stack for this session's worktree: "live" | "starting"
                  | "off" (another tree of the project owns it, or nothing runs), or
                  null when the worktree is not a wt-dev project
  ticket   obj    null when nothing is known, else
                  {issue, title, problem, pipeline, stage, stage_index, stage_total,
                   stages, tasks_done, tasks_total, checkpoints_done, checkpoints_total,
                   checkpoint, slug} — any field may be null. From `ticket-context <cwd>`
                  (cached 30 s per cwd); `issue` falls back to a tmux session named
                  `issue-<n>` or `pa-<n>`; `stage` falls back to the session's
                  @pipeline_label (set by pipeline-status) when ticket-context has none.
                  `pipeline` is "frontend" (travel-smart) or "pa" (personal-assistant);
                  `stages` the six short labels of its stage table (["Refine",
                  "Implement", …]), `stage_index` counting from 1 into them.

`board summary --json`:
  {"needs_you": n, "working": n, "background": n, "unseen": n,
   "designs": n,                                  # design entries across live sessions
   "stacks": {"<project>": {"state": "live|starting|failed|stopped",
                            "tree": "<worktree name>|null", "branch": "...|null"}}}

Caches live in $BOARD_DIR/cache/: ticket-context per cwd (30 s, `ctx<schema>-*`), `wt-dev status
--short` (5 s), the roster's mode. Python 3 stdlib only.
"""

import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

BOARD_DIR = Path(os.environ.get("BOARD_DIR") or Path.home() / ".cache/claude-board")
CACHE = BOARD_DIR / "cache"
SEEN = BOARD_DIR / "seen"
STALE_MS = 30_000
REAP_MS = 10 * 60_000
TICKET_TTL = 30
# Bumped whenever ticket-context's keys change: the per-cwd cache is shared by every
# board on the machine, and an older board (or ticket-context) must not serve a newer
# one its output for the 30 s it is fresh.
CTX_SCHEMA = 2
STACK_TTL = 5
STATES = ("needs_you", "working", "background", "idle")
GHOSTTY_CLASS = "com.mitchellh.ghostty"
TS_REPO = "WhiteWolfStudio/travel-smart"
ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


# ── small helpers ───────────────────────────────────────────────────────────────
def now_ms():
    return int(time.time() * 1000)


def run(args, timeout=3, cwd=None):
    """stdout of a command, or None when it fails / is missing / times out."""
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout, cwd=cwd)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def detach(args, cwd=None):
    """Fire and forget (xdg-open, gh --web, ghostty): never block on a GUI child. In
    its own transient systemd scope when possible, so a window started from a caller
    running as a service (streamdeck-dashboard) is not killed when that service is."""
    if shutil.which("systemd-run"):
        args = ["systemd-run", "--user", "--scope", "--quiet", "--collect", *args]
    try:
        subprocess.Popen(args, cwd=cwd, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError:
        return False


def pid_alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def norm_key(k):
    return k[1:] if k.startswith("%") else k


def elapsed(ms):
    s = max(0, int(ms // 1000))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    return f"{s // 3600}h{(s % 3600) // 60:02d}m"


def cached(name, ttl, produce):
    """JSON cache under $BOARD_DIR/cache: serve if younger than ttl, else produce."""
    f = CACHE / name
    try:
        if time.time() - f.stat().st_mtime < ttl:
            return json.loads(f.read_text())
    except (OSError, ValueError):
        pass
    val = produce()
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        tmp = f.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(val))
        tmp.replace(f)
    except OSError:
        pass
    return val


def die(msg, code=1):
    print(f"board: {msg}", file=sys.stderr)
    sys.exit(code)


# ── colours (~/.config/theme/sesh-colors.sh, dark-nord fallbacks) ────────────────
def theme():
    vals = {}
    for name in ("sesh-colors.sh", "ticket-colors.sh"):
        try:
            text = (Path.home() / ".config/theme" / name).read_text()
        except OSError:
            continue
        for m in re.finditer(r"^(\w+)=['\"]?([^'\"\n]*)", text, re.M):
            vals[m.group(1)] = m.group(2).strip().lstrip("#")
    fzf = dict(p.split(":", 1) for p in vals.get("SESH_FZF_COLORS", "").split(",") if ":" in p)
    fz = lambda k, d: fzf.get(k, d).lstrip("#")  # noqa: E731
    return {
        "red": vals.get("SESH_BELL_COLOR", "bf616a"),
        # needs you is rust (attn) in every theme; before the next theme-switch the
        # file has no SESH_ATTN_COLOR, so the rust is the fallback, never red.
        "attn": vals.get("SESH_ATTN_COLOR", "e0703a"),
        "yellow": vals.get("SESH_BUSY_COLOR", "ebcb8b"),
        "green": vals.get("SESH_OK_COLOR", "a3be8c"),
        "dim": vals.get("SESH_DIM_COLOR", "6c7a96"),
        "accent": vals.get("SESH_ACCENT_COLOR", "88c0d0"),
        "text": vals.get("SESH_TEXT_COLOR", "d8dee9"),
        # fg0 / blue / pill bg were added to sesh-colors.sh with the board; before the
        # next theme-switch they come from the fzf string (fg+ = fg0, prompt = blue).
        "fg0": vals.get("SESH_FG0_COLOR") or fz("fg+", "eceff4"),
        "blue": vals.get("SESH_BLUE_COLOR") or fz("prompt", "81a1c1"),
        "bg0": vals.get("SESH_BG_COLOR") or fz("bg", "0a0b0e"),
        "pill": vals.get("SESH_PILL_BG") or vals.get("TICKET_PILL_BG") or "29303c",
        "fzf": vals.get("SESH_FZF_COLORS", ""),
    }


class Paint:
    def __init__(self, on=True):
        self.on = on
        self.t = theme()

    def __call__(self, role, s, bold=False):
        if not self.on or not s:
            return s
        h = self.t.get(role, role)
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
        return f"\033[{'1;' if bold else ''}38;2;{r};{g};{b}m{s}\033[0m"


# ── tmux facts (one call each) ───────────────────────────────────────────────────
def tmux_sessions():
    """{session: {"pstate", "plabel"}} — pipeline-status's options."""
    out = run(["tmux", "list-sessions", "-F", "#{session_name}\t#{@pipeline_state}\t#{@pipeline_label}"], timeout=2)
    res = {}
    for ln in (out or "").splitlines():
        p = (ln.split("\t") + ["", ""])[:3]
        if p[0]:
            res[p[0]] = {"pstate": p[1], "plabel": p[2]}
    return res


def focused_panes():
    """Panes some tmux client is looking at right now (its current window's active pane)."""
    out = run(["tmux", "list-clients", "-F", "#{pane_id}"], timeout=2)
    return {ln.strip() for ln in (out or "").splitlines() if ln.strip()}


# ── wt-dev ───────────────────────────────────────────────────────────────────────
WT_STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "wt-dev"
WT_LINE = re.compile(r"^\s+(\S+)\s+(?:●|○|◐|✗)\s+(live|stopped|starting|failed)(?:\s+(\S+)\s+(\S+))?")


def wt_status():
    """{project: {state, tree, branch}} parsed from `wt-dev status --short` (cached 5 s).

    A line reads `  travel-smart   ● live  <tree>  <branch>`; only `live` names its
    tree, so for starting/failed the tree comes from wt-dev's own state file."""
    def produce():
        out = run(["wt-dev", "status", "--short"], timeout=5) or ""
        res = {}
        for ln in ANSI_RE.sub("", out).splitlines():
            m = WT_LINE.match(ln)
            if not m:
                continue
            proj, state, tree, branch = m.groups()
            if state in ("starting", "failed") and not tree:
                try:
                    for kv in (WT_STATE / f"{proj}.state").read_text().splitlines():
                        k, _, v = kv.partition("=")
                        if k == "tree" and v:
                            tree = os.path.basename(v)
                        elif k == "branch" and v:
                            branch = v
                except OSError:
                    pass
            res[proj] = {"state": state, "tree": tree, "branch": branch}
        return res
    return cached("wt-status.json", STACK_TTL, produce)


def wt_project(main):
    """The wt-dev project name declared by <main>/.wtdev.toml, or None."""
    try:
        text = (Path(main) / ".wtdev.toml").read_text()
    except OSError:
        return None
    m = re.search(r'^\s*name\s*=\s*"([^"]+)"', text, re.M)
    return m.group(1) if m else os.path.basename(main)


def stack_urls(proj, main):
    """The project's URLs: from `wt-dev status` (its block), else .wtdev.toml `urls`."""
    out = ANSI_RE.sub("", run(["wt-dev", "status"], timeout=8) or "")
    urls, inside = [], False
    for ln in out.splitlines():
        h = re.match(r"^  (\S+)\s{2,}", ln)
        if h:
            inside = h.group(1) == proj
            continue
        if inside:
            urls += re.findall(r"https?://\S+", ln)
    if not urls and main:
        try:
            text = (Path(main) / ".wtdev.toml").read_text()
            m = re.search(r"^\s*urls\s*=\s*\[(.*)\]", text, re.M)
            if m:
                urls = [u.split("=", 1)[-1] for u in re.findall(r'"([^"]+)"', m.group(1))]
        except OSError:
            pass
    front = [u for u in urls if "5173" in u or "frontend" in u]
    return front + [u for u in urls if u not in front]


# ── per-worktree context (ticket-context + git, cached 30 s per cwd) ────────────
def worktree_ctx(cwd):
    def produce():
        ctx = {"tc": {}, "toplevel": None, "main": None, "project": None, "remote": None}
        if not cwd or not os.path.isdir(cwd):
            return ctx
        out = run(["ticket-context", cwd], timeout=4) or ""
        for ln in out.splitlines():
            try:
                toks = shlex.split(ln)
            except ValueError:
                continue
            if toks and "=" in toks[0]:
                k, _, v = toks[0].partition("=")
                ctx["tc"][k] = v
        g = run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--show-toplevel", "--git-common-dir"])
        if g:
            parts = g.splitlines()
            if len(parts) >= 2:
                ctx["toplevel"] = parts[0]
                common = parts[1]
                ctx["main"] = os.path.dirname(common) if common.endswith("/.git") else parts[0]
                ctx["project"] = wt_project(ctx["main"])
        ctx["remote"] = (run(["git", "-C", cwd, "remote", "get-url", "origin"]) or "").strip() or None
        return ctx
    return cached(f"ctx{CTX_SCHEMA}-" + hashlib.sha1((cwd or "").encode()).hexdigest()[:16] + ".json", TICKET_TTL, produce)


def _int(v):
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def build_ticket(e, ctx, sessions):
    tc = ctx["tc"]
    sess = (e.get("tmux") or {}).get("session") or ""
    issue = _int(tc.get("issue"))
    if issue is None:
        m = re.fullmatch(r"(?:issue|pa)-(\d+)", sess)
        issue = int(m.group(1)) if m else None
    on_ticket = bool(tc.get("slug") or tc.get("pipeline")) or issue is not None
    t = {
        "issue": issue,
        "title": tc.get("title") or None,
        "problem": tc.get("problem") or None,
        "pipeline": tc.get("pipeline") if on_ticket else None,
        # ticket-context reports stage 1 for ANY git dir with no ticket folder, so its
        # stage only means something on a ticket.
        "stage": tc.get("stage") if on_ticket else None,
        "stage_index": _int(tc.get("stage_index")) if on_ticket else None,
        "stage_total": _int(tc.get("stage_total")) if on_ticket else None,
        "stages": (tc.get("stage_labels") or "").split(",") if on_ticket and tc.get("stage_labels") else None,
        "tasks_done": _int(tc.get("tasks_done")),
        "tasks_total": _int(tc.get("tasks_total")),
        "checkpoints_done": _int(tc.get("checkpoints_done")),
        "checkpoints_total": _int(tc.get("checkpoints_total")),
        "checkpoint": tc.get("checkpoint") or None,
        "slug": tc.get("slug") or None,
    }
    if not t["stage"]:
        label = sessions.get(sess, {}).get("plabel")
        if label:
            t["stage"] = label
    return t if any(v is not None for v in t.values()) else None


def stack_state(ctx, wt):
    proj = ctx.get("project")
    if not proj or proj not in wt:
        return None
    s = wt[proj]
    mine = s.get("tree") and ctx.get("toplevel") and s["tree"] == os.path.basename(ctx["toplevel"])
    if s["state"] == "live" and mine:
        return "live"
    if s["state"] == "starting" and mine:
        return "starting"
    return "off"


# ── loading ──────────────────────────────────────────────────────────────────────
def load(enrich=True, stacks=True):
    """Every live state file, enriched and sorted. Each entry carries a private
    `_ctx` (worktree context) that is stripped before JSON output. `stacks=False`
    skips `wt-dev status` (the status line has no use for it); `stack` is then None."""
    now = now_ms()
    entries = []
    for f in sorted(BOARD_DIR.glob("*.json")):
        try:
            e = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(e, dict):
            continue
        hb = e.get("heartbeat") or 0
        stale = now - hb > STALE_MS and not pid_alive(e.get("pid"))
        if stale and now - hb > REAP_MS:
            try:
                f.unlink()
            except OSError:
                pass
            continue
        if e.get("state") not in STATES:
            e["state"] = "idle"
        e["key"] = f.stem
        e["stale"] = stale
        entries.append(e)

    sessions = tmux_sessions() if entries else {}
    focused = focused_panes() if entries else set()
    wt = wt_status() if (entries and enrich and stacks) else {}
    for e in entries:
        # Unseen: finished after the last time anyone looked. A pane a client is
        # looking at right now counts as looked at.
        fin = e.get("finished_at") or 0
        seen_f = SEEN / e["key"]
        pane = (e.get("tmux") or {}).get("pane")
        try:
            seen_ms = int(seen_f.stat().st_mtime * 1000)
        except OSError:
            seen_ms = 0
        unseen = e["state"] == "idle" and not e["stale"] and fin > seen_ms
        if unseen and pane and pane in focused:
            mark_seen(e["key"])
            unseen = False
        e["unseen"] = unseen
        if enrich:
            ctx = worktree_ctx(e.get("cwd"))
            e["_ctx"] = ctx
            e["ticket"] = build_ticket(e, ctx, sessions)
            e["stack"] = stack_state(ctx, wt)
        else:
            e["_ctx"] = {"tc": {}}
            e["ticket"] = None
            e["stack"] = None
    entries.sort(key=sort_key)
    return entries


def rank(e):
    if e.get("stale"):
        return 5
    if e["state"] == "idle":
        return 3 if e.get("unseen") else 4
    return STATES.index(e["state"])


def sort_key(e):
    att = (e.get("attention") or {}).get("since") or e.get("since") or 0
    return (rank(e), att if e["state"] == "needs_you" else 0,
            (e.get("tmux") or {}).get("session") or "", e["key"])


def public(e):
    return {k: v for k, v in e.items() if not k.startswith("_")}


def find(key):
    key = norm_key(key)
    for e in load():
        if e["key"] == key:
            return e
    die(f"no session with key {key}")


def mark_seen(key):
    try:
        SEEN.mkdir(parents=True, exist_ok=True)
        p = SEEN / key
        p.touch()
        os.utime(p, None)
    except OSError:
        pass


# ── text for a row / a status ────────────────────────────────────────────────────
def running(e, kind):
    return [x for x in (e.get(kind) or []) if x.get("status") in ("running", "needs_you")]


def is_slow(e, now=None):
    cur = e.get("current") or {}
    typ = cur.get("typical_ms")
    return bool(typ and cur.get("started") and (now or now_ms()) - cur["started"] > typ)


def doing(e, now=None):
    """What the session is doing, in a few words."""
    now = now or now_ms()
    st = e["state"]
    if e.get("stale"):
        return "stale"
    if st == "needs_you":
        a = e.get("attention") or {}
        return "needs you · " + (a.get("title") or a.get("kind") or "?")
    if st == "working":
        cur = e.get("current") or {}
        what = cur.get("detail") or cur.get("tool") or "working"
        el = elapsed(now - (cur.get("started") or e.get("since") or now))
        return f"{what} {el}" + (" slow" if is_slow(e, now) else "")
    if st == "background":
        n = len(running(e, "agents"))
        if n:
            return f"background · {n} agent{'s' if n != 1 else ''}"
        n = len(running(e, "shells"))
        return f"background · {n} shell{'s' if n != 1 else ''}"
    return "unseen" if e.get("unseen") else "idle"


GLYPH = {"needs_you": "●", "working": "▶", "background": "◐", "unseen": "✓", "idle": "○", "stale": "○"}


def status_role(e):
    if e.get("stale"):
        return "dim", "stale"
    st = e["state"]
    if st == "needs_you":
        return "attn", st
    if st == "working":
        return ("yellow" if is_slow(e) else "fg0"), st
    if st == "background":
        return "blue", st
    if e.get("unseen"):
        return "green", "unseen"
    return "dim", "idle"


def label_for(e):
    t = e.get("ticket") or {}
    if t.get("issue"):
        return f"#{t['issue']}"
    return (e.get("tmux") or {}).get("session") or os.path.basename(e.get("cwd") or "") or e["key"]


def brief_for(e):
    t = e.get("ticket") or {}
    return t.get("problem") or t.get("title") or e.get("branch") or os.path.basename(e.get("cwd") or "")


# ── where a pipeline is: its six stages ─────────────────────────────────────────
DEFAULT_STAGES = ["Start", "Implement", "Review", "Docs", "Verify", "PR"]


def on_pipeline(e):
    t = e.get("ticket") or {}
    return bool(t.get("stage_index"))


def stage_labels(e):
    t = e.get("ticket") or {}
    labels = t.get("stages") or []
    return labels if len(labels) == 6 else DEFAULT_STAGES


def impl_count(t):
    """Implement's count: the checklist's tasks (travel-smart), else the issue's
    checkpoints (personal-assistant); "" when neither is known."""
    if t.get("tasks_total"):
        return f"{t.get('tasks_done') or 0}/{t['tasks_total']}"
    if t.get("checkpoints_total"):
        return f"{t.get('checkpoints_done') or 0}/{t['checkpoints_total']}"
    return ""


def stage_label(e):
    """The current stage's label ("Verify"), or the raw stage word off the table."""
    t = e.get("ticket") or {}
    i = t.get("stage_index")
    if i and 1 <= i <= 6:
        return stage_labels(e)[i - 1]
    return t.get("stage") or ""


def stage_word(e):
    """The short word under a pill: `verify`, `impl 3/5`."""
    t = e.get("ticket") or {}
    if t.get("stage_index") == 2:
        n = impl_count(t)
        return "impl" + (f" {n}" if n else "")
    return stage_label(e).lower()


def strip_cells(e):
    """Six (glyph, role) cells: done ✓, the current one by state (! needs you,
    ▶ working, ◐ background, ○ idle), then ○ still ahead."""
    idx = (e.get("ticket") or {}).get("stage_index") or 0
    role, st = status_role(e)
    now_glyph = {"needs_you": "!", "working": "▶", "background": "◐"}.get(st, "○")
    now_role = role if st in ("needs_you", "working", "background") else "text"
    cells = []
    for i in range(1, 7):
        if i < idx:
            cells.append(("✓", "green"))
        elif i == idx:
            cells.append((now_glyph, now_role))
        else:
            cells.append(("○", "dim"))
    return cells


def activity(e, now=None):
    """What is running, in two or three words with its elapsed time: `agent 5m`,
    `Bash 12s`, `needs you · Results`."""
    now = now or now_ms()
    st = e["state"]
    if e.get("stale"):
        return "stale"
    if st == "needs_you":
        a = e.get("attention") or {}
        return "needs you · " + (a.get("title") or a.get("kind") or "?")
    if st == "working":
        cur = e.get("current") or {}
        return f"{cur.get('tool') or 'working'} {elapsed(now - (cur.get('started') or e.get('since') or now))}"
    if st == "background":
        for kind, word in (("agents", "agent"), ("shells", "shell")):
            r = running(e, kind)
            if r:
                first = min(x.get("started") or now for x in r)
                more = f" +{len(r) - 1}" if len(r) > 1 else ""
                return f"{word}{more} {elapsed(now - first)}"
        return "background"
    if e.get("unseen"):
        return f"unseen {elapsed(now - (e.get('finished_at') or e.get('since') or now))}"
    return f"idle {elapsed(now - (e.get('since') or now))}"


def fit(s, n):
    s = (s or "").replace("\t", " ").replace("\n", " ")
    return s if len(s) <= n else s[: max(0, n - 1)] + "…"


def row(e, paint, widths=(10, 38, 34)):
    role, st = status_role(e)
    chip = {"live": paint("green", "● stack"), "starting": paint("yellow", "◐ stack")}.get(e.get("stack"), "")
    return "  ".join([
        paint(role, GLYPH[st]),
        paint("accent", f"{fit(label_for(e), widths[0]):<{widths[0]}}"),
        paint("text", f"{fit(brief_for(e), widths[1]):<{widths[1]}}"),
        paint(role, f"{fit(doing(e), widths[2]):<{widths[2]}}"),
        chip,
    ]).rstrip()


# ── commands ─────────────────────────────────────────────────────────────────────
def cmd_list(args):
    entries = load()
    if "--json" in args:
        print(json.dumps([public(e) for e in entries], ensure_ascii=False))
        return
    paint = Paint(sys.stdout.isatty())
    for e in entries:
        print(row(e, paint))


def summarize(entries):
    live = [e for e in entries if not e.get("stale")]
    wt = wt_status()
    return {
        "needs_you": sum(e["state"] == "needs_you" for e in live),
        "working": sum(e["state"] == "working" for e in live),
        "background": sum(e["state"] == "background" for e in live),
        "unseen": sum(bool(e.get("unseen")) for e in live),
        "designs": sum(len(e.get("designs") or []) for e in live),
        "stacks": {p: {"state": s["state"], "tree": s.get("tree"), "branch": s.get("branch")} for p, s in wt.items()},
    }


def cmd_summary(args):
    s = summarize(load())
    if "--json" in args:
        print(json.dumps(s, ensure_ascii=False))
        return
    print(f"{s['needs_you']} needs you · {s['working']} working · {s['background']} background · "
          f"{s['unseen']} unseen · {s['designs']} designs")
    for p, st in s["stacks"].items():
        tail = f"  {st['tree']}  {st['branch'] or ''}" if st.get("tree") and st["state"] != "stopped" else ""
        print(f"  {p:<16} {st['state']}{tail}")


# ── tmux status line ─────────────────────────────────────────────────────────────
# Each command prints its pill(s) whole, caps included, or nothing: an empty pill
# still renders as a blob and tmux cannot branch on a #()'s output. tmux re-reads
# `#[…]` in the output, so text from a state file goes through tesc().
CAP_O, CAP_C = "\ue0b6", "\ue0b4"            # round caps
THIN_O, THIN_C = "\ue0b7", "\ue0b5"          # thin (outline) round caps


def tesc(s):
    return (s or "").replace("#", "##")


def blend(fg, bg, a):
    """`fg` at opacity `a` over `bg`, as hex: tmux has no alpha."""
    f = [int(fg[i:i + 2], 16) for i in (0, 2, 4)]
    b = [int(bg[i:i + 2], 16) for i in (0, 2, 4)]
    return "".join(f"{round(x * a + y * (1 - a)):02x}" for x, y in zip(f, b))


def tmux_role(t, e):
    role, _st = status_role(e)
    return t[role] if role in t else t["text"]


def status_lines(want_two, current):
    """Two status lines while any Claude session is open, one otherwise. The pill job
    passes `#{status}` in, so this only touches tmux when the answer changes."""
    if current and (current == "2") != want_two:
        run(["tmux", "set-option", "-g", "status", "2" if want_two else "on"], timeout=2)


def cmd_pill(args):
    """Status line 1, right: the counts `● N ▶ N ◐ N ✓ N` (needs you in rust, working
    frost or yellow once slow, background steel, unseen green) in one pill; nothing
    when all quiet. `board pill #{status}` also keeps the second line on while any
    session is open (see status_lines)."""
    entries = [e for e in load(enrich=False) if not e.get("stale")]
    if args:
        status_lines(bool(entries), args[0])
    need = sum(e["state"] == "needs_you" for e in entries)
    work = [e for e in entries if e["state"] == "working"]
    bg = sum(e["state"] == "background" for e in entries)
    unseen = sum(bool(e.get("unseen")) for e in entries)
    t = theme()
    inner = []
    if need:
        inner.append(f"#[fg=#{t['attn']},bold]● {need}#[nobold]")
    if work:
        inner.append(f"#[fg=#{t['yellow'] if any(is_slow(e) for e in work) else t['fg0']}]▶ {len(work)}")
    if bg:
        inner.append(f"#[fg=#{t['blue']}]◐ {bg}")
    if unseen:
        inner.append(f"#[fg=#{t['green']}]✓ {unseen}")
    if not inner:
        return
    sys.stdout.write(f"#[fg=#{t['pill']},bg=default]{CAP_O}#[bg=#{t['pill']}] {' '.join(inner)} "
                     f"#[fg=#{t['pill']},bg=default]{CAP_C}#[bg=default] ")


def cmd_here(args):
    """Status line 1, left: this tmux session's Claude — `#1964 Invoice discount
    control · Verify · agent 5m` — or, with no Claude in it, `ticket-pill`'s pill.

      board here <session> <client_width>"""
    sess = args[0] if args else ""
    try:
        width = int(args[1]) if len(args) > 1 else 200
    except ValueError:
        width = 200
    mine = [e for e in load(stacks=False) if (e.get("tmux") or {}).get("session") == sess and not e.get("stale")]
    if not mine:
        if shutil.which("ticket-pill"):
            sys.stdout.write(run(["ticket-pill", sess, str(width)], timeout=4) or "")
        return
    e = mine[0]                            # load() sorts the most urgent first
    t, tk = theme(), e.get("ticket") or {}
    # Same budget as ticket-pill: the session pill, the centred window list and the
    # right side come out of the width first; below the floor the pill drops out.
    budget = min(width - 108, 76)
    if budget < 24:
        return
    tail = " · ".join(x for x in (stage_label(e) if on_pipeline(e) else "", activity(e)) if x)
    num = f"#{tk['issue']} " if tk.get("issue") else ""
    name = tk.get("title") or tk.get("problem") or e.get("branch") or os.path.basename(e.get("cwd") or "")
    room = budget - len(num) - len(tail) - 3
    if room < 8:
        name, room = "", 0
    text = fit(name, room) if room else ""
    sys.stdout.write(
        f"#[fg=#{t['pill']},bg=default]{CAP_O}#[bg=#{t['pill']}] "
        + (f"#[fg=#{t['dim']}]{tesc(num)}" if num else "")
        + (f"#[fg=#{t['text']}]{tesc(text)} " if text else "")
        + f"#[fg=#{tmux_role(t, e)}]{'· ' if text or num else ''}{tesc(tail)} "
        + f"#[fg=#{t['pill']},bg=default]{CAP_C}#[bg=default] ")


def pipeline_pill(e, t, this):
    """`● #2021 !○○○○○ start`: glyph, number, the six-cell strip, the stage word.
    Needs-you pills sit on a rust tint; this session's is outlined in rust."""
    role, st = status_role(e)
    fg = tmux_role(t, e)
    bg = blend(t["attn"], t["bg0"], 0.16) if st == "needs_you" else t["pill"]
    num = (e.get("ticket") or {}).get("issue")
    strip = "".join(f"#[fg=#{t[r]}]{g}" for g, r in strip_cells(e))
    body = (f"#[fg=#{fg}]{GLYPH[st]} #[fg=#{t['text']}]##{num} {strip} #[fg=#{fg}]{tesc(stage_word(e))}")
    vis = 2 + len(f"#{num}") + 1 + 6 + 1 + len(stage_word(e)) + 4
    if this:
        a = t["attn"]
        pill = (f"#[fg=#{a},bg=default]{THIN_O}#[bg=#{bg},overline,underscore,us=#{a}] {body} "
                f"#[fg=#{a},bg=default,nooverline,nounderscore,us=default]{THIN_C}#[bg=default]")
    else:
        pill = f"#[fg=#{bg},bg=default]{CAP_O}#[bg=#{bg}] {body} #[fg=#{bg},bg=default]{CAP_C}#[bg=default]"
    return pill, vis


def cmd_pipelines(args):
    """Status line 2: a pill per pipeline (a session with a ticket on a stage table),
    most urgent first, this session's outlined, then the other sessions as counts.
    Pills that do not fit the width are folded into the count.

      board pipelines <session> <client_width>"""
    sess = args[0] if args else ""
    try:
        width = int(args[1]) if len(args) > 1 else 200
    except ValueError:
        width = 200
    entries = [e for e in load(stacks=False) if not e.get("stale")]
    if not entries:
        return
    t = theme()
    pipes = [e for e in entries if on_pipeline(e)]
    others = [e for e in entries if not on_pipeline(e)]
    pills = [(e, *pipeline_pill(e, t, (e.get("tmux") or {}).get("session") == sess)) for e in pipes]

    def rest_pill(rest):
        if not rest:
            return "", 0
        counts = {}
        for e in rest:
            _r, st = status_role(e)
            counts[st] = counts.get(st, 0) + 1
        order = [("needs_you", "attn"), ("working", "fg0"), ("background", "blue"), ("unseen", "green"), ("idle", "dim")]
        parts = [f"#[fg=#{t[r]}]{GLYPH[s] if s != 'idle' else '○'} {counts[s]}" for s, r in order if counts.get(s)]
        label = "+ other sessions" if pipes else "sessions"
        txt = f"#[fg=#{t['dim']}]{label} " + " ".join(parts)
        vis = len(label) + 1 + sum(len(str(counts[s])) + 3 for s, _ in order if counts.get(s)) + 4
        return f"#[fg=#{t['pill']},bg=default]{CAP_O}#[bg=#{t['pill']}] {txt} #[fg=#{t['pill']},bg=default]{CAP_C}#[bg=default]", vis

    # Drop from the end (least urgent) until it fits, never this session's pill.
    shown, folded = list(pills), []
    while True:
        rp, rvis = rest_pill(others + folded)
        used = sum(v + 1 for _e, _p, v in shown) + rvis
        if used <= width or not shown:
            break
        drop = next((i for i in range(len(shown) - 1, -1, -1)
                     if (shown[i][0].get("tmux") or {}).get("session") != sess), None)
        if drop is None:
            break
        folded.insert(0, shown.pop(drop)[0])
    sys.stdout.write(" ".join(p for _e, p, _v in shown) + (" " if shown and rp else "") + rp)


def tmux_client():
    """The client to drive from outside tmux: the most recently active one."""
    out = run(["tmux", "list-clients", "-F", "#{client_activity} #{client_name}"], timeout=2) or ""
    best, best_t = None, -1
    for ln in out.splitlines():
        act, _, name = ln.partition(" ")
        t = int(act) if act.isdigit() else 0
        if name and t >= best_t:
            best, best_t = name, t
    return best


def focus_terminal():
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"):
        run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "class:{GHOSTTY_CLASS}" }})'])


def jump(e):
    t = e.get("tmux") or {}
    pane = t.get("pane")
    if not pane:
        die(f"{e['key']} is not in tmux (cwd {e.get('cwd')})")
    sess = (run(["tmux", "display-message", "-p", "-t", pane, "#{session_name}"]) or "").strip() or t.get("session")
    if not sess:
        die(f"pane {pane} is gone")
    if os.environ.get("TMUX"):
        client = []
    else:
        c = tmux_client()
        if not c:
            focus_terminal()
            detach(["ghostty", "-e", "tmux", "attach", "-t", f"={sess}"])
            mark_seen(e["key"])
            return
        client = ["-c", c]
    run(["tmux", "switch-client", *client, "-t", f"={sess}"])
    run(["tmux", "select-window", "-t", pane])
    run(["tmux", "select-pane", "-t", pane])
    focus_terminal()
    mark_seen(e["key"])


def cmd_jump(args):
    if not args:
        die("usage: board jump <key>")
    jump(find(args[0]))


def cmd_next(_args):
    need = [e for e in load(enrich=False) if e["state"] == "needs_you" and not e.get("stale")]
    if not need:
        print("nothing needs you")
        return
    need.sort(key=lambda e: (e.get("attention") or {}).get("since") or e.get("since") or 0)
    jump(need[0])


def cmd_answer(args):
    if len(args) < 2:
        die("usage: board answer <key> <n>")
    e, n = find(args[0]), args[1]
    if e["state"] != "needs_you":
        die(f"{e['key']} is not waiting on you")
    opts = [o.get("key") for o in (e.get("attention") or {}).get("options") or []]
    if opts and n not in opts:
        die(f"{e['key']} has no option {n} (options: {' '.join(opts)})")
    pane = (e.get("tmux") or {}).get("pane")
    if not pane:
        die(f"{e['key']} is not in tmux")
    if run(["tmux", "send-keys", "-t", pane, n]) is None:
        die(f"send-keys to {pane} failed")


def stack_plan(e):
    """(worktree, project, lines describing what `board stack --yes` would do, already_live)."""
    ctx = e.get("_ctx") or {}
    tree, proj = ctx.get("toplevel"), ctx.get("project")
    if not tree or not proj:
        return None, None, [f"{label_for(e)}: not a wt-dev project ({e.get('cwd')})"], False
    s = wt_status().get(proj, {"state": "stopped"})
    name = os.path.basename(tree)
    lines = [f"worktree  {name}  ({tree})", f"project   {proj}"]
    if e.get("stack") in ("live", "starting"):
        return tree, proj, lines + [f"already {e['stack']} — nothing to do"], True
    if s["state"] in ("live", "starting", "failed") and s.get("tree"):
        lines.append(f"stops     {proj} {s['state']} on {s['tree']}" + (f" ({s['branch']})" if s.get("branch") else ""))
    else:
        lines.append(f"stops     nothing ({proj} is {s['state']})")
    lines.append(f"runs      wt-dev use {tree} --db auto")
    return tree, proj, lines, False


def cmd_stack(args):
    if not args:
        die("usage: board stack <key> [--yes]")
    e = find(args[0])
    tree, _proj, lines, live = stack_plan(e)
    if "--yes" not in args or not tree or live:
        print("\n".join(lines))
        if tree and not live:
            print("(dry run — add --yes to switch)")
        sys.exit(0 if tree else 1)
    r = subprocess.run(["wt-dev", "use", tree, "--db", "auto"])
    try:
        (CACHE / "wt-status.json").unlink()
    except OSError:
        pass
    sys.exit(r.returncode)


def newest_design(e):
    ds = [d for d in (e.get("designs") or []) if d.get("url")]
    return max(ds, key=lambda d: d.get("at") or 0) if ds else None


def cmd_design(args):
    if not args:
        die("usage: board design <key> [--copy]")
    d = newest_design(find(args[0]))
    if not d:
        die("no design published from this session")
    if "--copy" in args:
        try:
            subprocess.run(["wl-copy", d["url"]], timeout=3, check=False)
        except (OSError, subprocess.SubprocessError):
            die("wl-copy failed")
    else:
        detach(["xdg-open", d["url"]])


def cmd_seen(args):
    if not args:
        die("usage: board seen <key|%pane>")
    key = norm_key(args[0])
    if (BOARD_DIR / f"{key}.json").exists():
        mark_seen(key)


KEYS = [
    ("In the roster", "j k", "Move"),
    ("In the roster", "⏎", "Jump to the session"),
    ("In the roster", "1-9", "Answer the question with that option"),
    ("In the roster", "s s", "Switch the dev stack to this worktree (press twice)"),
    ("In the roster", "v", "Open the newest design"),
    ("In the roster", "y", "Copy the design link"),
    ("In the roster", "o", "Open the live stack (localhost)"),
    ("In the roster", "t", "Open the GitHub issue"),
    ("In the roster", "c", "Show the checklist"),
    ("In the roster", "/", "Filter"),
    ("In the roster", "?", "Show these keys"),
    ("In the roster", "esc", "Close (or leave the filter)"),
    ("Agent board", "SUPER+G", "Roster (quickshell)"),
    ("Agent board", "SUPER+N", "Jump to the oldest session that needs you"),
    ("Agent board", "SUPER+Shift+G", "Checklist wall (quickshell)"),
    ("Agent board", "SUPER+/", "Keys cheatsheet"),
    ("Agent board", "prefix+i", "Roster in a tmux popup"),
]


def keys_text():
    out, group = [], None
    for g, k, d in KEYS:
        if g != group:
            out.append(("" if group is None else "\n") + g)
            group = g
        out.append(f"  {k:<14} {d}")
    return "\n".join(out)


def cmd_keys(args):
    if "--json" in args:
        print(json.dumps([{"group": g, "keys": k, "desc": d} for g, k, d in KEYS], ensure_ascii=False))
    else:
        print(keys_text())


# ── roster (fzf) ─────────────────────────────────────────────────────────────────
MODE_FILE = CACHE / "roster-mode"


def get_mode():
    try:
        mode, _, key = MODE_FILE.read_text().strip().partition(" ")
        return mode, key
    except OSError:
        return "", ""


def set_mode(mode, key=""):
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        MODE_FILE.write_text(f"{mode} {key}".strip())
    except OSError:
        pass


def roster_row(e, paint, width):
    """`● #2021 !○○○○○ Agency feature switches…  2m` for a pipeline; a plain session
    is `✓ travelsmart · develop   unseen 5m`. Glyph and number in the state's colour."""
    role, st = status_role(e)
    now = now_ms()
    when = elapsed(now - (e.get("since") or now))
    chip = {"live": paint("green", " ● stack"), "starting": paint("yellow", " ◐ stack")}.get(e.get("stack"), "")
    chip_w = 8 if chip else 0
    if on_pipeline(e):
        num = fit(label_for(e), 6)
        strip = "".join(paint(r, g) for g, r in strip_cells(e))
        room = max(10, width - 2 - 7 - 7 - 1 - len(when) - chip_w)
        return (f"{paint(role, GLYPH[st] + ' ' + f'{num:<6}', bold=st != 'idle')} {strip} "
                f"{paint('text', f'{fit(brief_for(e), room):<{room}}')} {paint('dim', when)}{chip}")
    sess = (e.get("tmux") or {}).get("session") or os.path.basename(e.get("cwd") or "") or e["key"]
    name = f"{sess} · {e['branch']}" if e.get("branch") else sess
    tail = activity(e, now) + (" slow" if is_slow(e, now) else "")
    room = max(10, width - 2 - len(tail) - 2 - chip_w)
    dim = st in ("idle", "stale")
    return (f"{paint(role, GLYPH[st])} {paint('dim' if dim else 'text', f'{fit(name, room):<{room}}')}  "
            f"{paint(role if not dim else 'dim', tail)}{chip}")


def roster_rows():
    paint = Paint(True)
    cols = int(os.environ.get("FZF_COLUMNS") or 0) or shutil.get_terminal_size((160, 40)).columns
    width = max(40, cols // 2 - 4)          # the list is the left half (preview right:50%)
    for e in load():
        print(f"{e['key']}\t{roster_row(e, paint, width)}")


def wrap(text, width, indent="  "):
    import textwrap
    return [indent + ln for ln in textwrap.wrap(text or "", max(20, width - len(indent))) or [""]]


def stepper(e, paint, width):
    """The text stepper: six nodes on a line (● done, ◉ now in the state's colour,
    ○ ahead), green ━ up to the current stage, then the labels and, under Implement,
    its count, under the current stage its elapsed time.

        ●━━━━━━━●━━━━━━━●━━━━━━━◉───────○───────○
      Start  Implement Review   Docs   Verify    PR
               17/17                    5m
    """
    t = e.get("ticket") or {}
    idx = t.get("stage_index") or 0
    labels = stage_labels(e)
    role, st = status_role(e)
    now_role = role if st in ("needs_you", "working", "background") else "text"
    left = 4
    gap = max(6, (width - left - 4) // 5)
    pos = [left + i * gap for i in range(6)]
    line = ""
    for i in range(6):
        n = i + 1
        node = paint("green", "●") if n < idx else paint(now_role, "◉", bold=True) if n == idx else paint("dim", "○")
        if i:
            seg = ("━" if n <= idx else "─") * (gap - 1)
            line += paint("green" if n <= idx else "dim", seg)
        line += node
    out = [" " * left + line]

    def under(texts):
        """One line with each (text, role) centred under its node, never overlapping."""
        s, col = "", 0
        for i, (txt, r, bold) in enumerate(texts):
            if not txt:
                continue
            at = max(col, pos[i] - len(txt) // 2, 0)
            s += " " * (at - col) + paint(r, txt, bold=bold)
            col = at + len(txt) + 1
            s += " "
        return s.rstrip()

    lab = []
    for i, l in enumerate(labels):
        n = i + 1
        lab.append((l, now_role if n == idx else "text" if n < idx else "dim", n == idx))
    out.append(under(lab))
    subs = [("", "dim", False)] * 6
    if impl_count(t):
        subs[1] = (impl_count(t), "dim", False)
    if 1 <= idx <= 6 and idx != 2:
        subs[idx - 1] = (elapsed(now_ms() - (e.get("since") or now_ms())), "dim", False)
    if any(s[0] for s in subs):
        out.append(under(subs))
    return out


def stack_line(e):
    """`live · o open`, `off · issue-1654 owns travel-smart`, …"""
    st = e.get("stack")
    if not st:
        return None, None
    if st in ("live", "starting"):
        return st, "o open"
    proj = (e.get("_ctx") or {}).get("project")
    s = wt_status().get(proj or "", {})
    owner = (f"live on {s['tree']}" if s.get("tree") and s.get("state") in ("live", "starting")
             else f"{proj} is {s.get('state') or 'stopped'}")
    return st, f"{owner} · s s switch here"


def preview(key):
    paint = Paint(True)
    width = int(os.environ.get("FZF_PREVIEW_COLUMNS") or 80)
    key = norm_key(key)
    e = next((x for x in load() if x["key"] == key), None)
    if not e:
        print("  (gone)")
        return
    mode, mkey = get_mode()
    if mode and mkey != key:
        # the cursor moved: a pending `s` confirmation (or checklist/keys view) is dropped
        set_mode("")
        mode = ""
    now = now_ms()
    role, st = status_role(e)
    t = e.get("ticket") or {}
    ctx = e.get("_ctx") or {}
    rule = "  " + paint("dim", "─" * max(10, width - 4))

    # ── what: the issue, its title, the problem
    out = []
    sess = (e.get("tmux") or {}).get("session") or ""
    where = ctx.get("project") or os.path.basename(ctx.get("main") or "") or sess
    if t.get("issue"):
        head = paint("text", f"#{t['issue']}") + " " + paint("fg0", fit(t.get("title") or brief_for(e), width - 12 - len(where)), bold=True)
        headw = len(f"#{t['issue']} ") + len(fit(t.get("title") or brief_for(e), width - 12 - len(where)))
    else:
        name = f"{sess} · {e['branch']}" if sess and e.get("branch") else sess or e.get("branch") or e["key"]
        head = paint("fg0", fit(name, width - 12 - len(where)), bold=True)
        headw = len(fit(name, width - 12 - len(where)))
    pad = max(2, width - 4 - headw - len(where))
    out.append("  " + head + " " * pad + paint("dim", where))
    problem = t.get("problem")
    if problem and problem != t.get("title"):
        out += [paint("text", ln) for ln in wrap(problem, width)]
    elif not t.get("issue") and e.get("cwd"):
        out.append("  " + paint("dim", fit(e["cwd"].replace(str(Path.home()), "~"), width - 4)))
    out.append("")

    if mode == "keys":
        out += [paint("text", "  " + ln) for ln in keys_text().splitlines()]
        print("\n".join(out))
        return
    if mode in ("stack", "stacked"):
        _tree, _proj, lines, live = stack_plan(e)
        if mode == "stack":
            out.append(paint("yellow", "  switch the dev stack?", bold=True))
            out += ["  " + paint("text", ln) for ln in lines]
            if not live and _tree:
                out += ["", paint("yellow", "  press s again to do it · move away to cancel")]
        else:
            out.append(paint("green", "  stack switch started", bold=True))
            try:
                log = (CACHE / f"stack-{key}.log").read_text()
                out += ["  " + paint("dim", ANSI_RE.sub("", ln)) for ln in log.splitlines()[-12:]]
            except OSError:
                pass
        print("\n".join(out))
        return
    if mode == "checklist":
        out += checklist_lines(e, paint, width)
        print("\n".join(out))
        return

    # ── where: the stepper
    if on_pipeline(e):
        out += stepper(e, paint, width)
        out.append("")
    out.append(rule)

    # ── now: the stage in words, then what is running, or the question
    stage = stage_label(e) if on_pipeline(e) else ""
    nowtxt = {"needs_you": "waiting on you", "working": "", "background": "agents and shells running",
              "unseen": "finished · not looked at yet", "idle": "idle", "stale": "gone quiet"}.get(st, "")
    if st == "working":
        cur = e.get("current") or {}
        nowtxt = cur.get("tool") or "working"
    head = paint(role, "NOW", bold=True) + "  " + (paint("fg0", stage, bold=True) + paint("text", " · ") if stage else "")
    out.append("  " + head + paint("text", fit(nowtxt, width - 12 - len(stage))))
    out.append("")
    if st == "needs_you":
        a = e.get("attention") or {}
        out.append(paint("attn", f"  ? {a.get('kind', 'question')} · {a.get('title') or ''}", bold=True))
        out += [paint("text", ln) for ln in wrap(a.get("text") or "", width, "    ")]
        for o in a.get("options") or []:
            out.append(f"    {paint('attn', o.get('key', '?'), bold=True)}  {paint('text', o.get('label', ''))}")
        out.append("")
    elif st == "working" and e.get("current"):
        cur = e["current"]
        el = elapsed(now - (cur.get("started") or now))
        typ = f" · typical {elapsed(cur['typical_ms'])}" if cur.get("typical_ms") else ""
        out.append("  " + paint(role, "▶") + " " + paint("text", fit(cur.get("detail") or cur.get("tool") or "", width - 24))
                   + paint("dim", f"  {el}{typ}"))
    # what is running, then what finished in the last quarter hour
    recent = now - 15 * 60_000
    ags = [a for a in e.get("agents") or [] if a.get("status") in ("running", "needs_you") or (a.get("ended") or 0) > recent]
    shs = [s for s in e.get("shells") or [] if s.get("status") == "running" or (s.get("started") or 0) > recent]
    for a in ags[:6]:
        s = a.get("status")
        g, r = {"running": ("◆", "blue"), "needs_you": ("●", "attn")}.get(s, ("✓", "green"))
        end = a.get("ended") or now
        el = elapsed(end - (a.get("started") or end))
        txt = fit(f"{a.get('type') or 'agent'} · {a.get('description') or ''}", width - 16)
        out.append(f"  {paint(r, g)} {paint('text' if s in ('running', 'needs_you') else 'dim', f'{txt:<{width - 16}}')} {paint('dim', el)}")
    for s in shs[:4]:
        live = s.get("status") == "running"
        el = elapsed(now - (s.get("started") or now))
        txt = fit(s.get("command") or "", width - 16)
        out.append(f"  {paint('blue', '$') if live else paint('green', '✓')} "
                   f"{paint('text' if live else 'dim', f'{txt:<{width - 16}}')} {paint('dim', el)}")
    tasks = e.get("tasks") or []
    if tasks:
        done = sum(x.get("status") == "completed" for x in tasks)
        cur = next((x for x in tasks if x.get("status") == "in_progress"), None)
        out.append("  " + paint("dim", "tasks ") + paint("text", f"{done}/{len(tasks)}")
                   + (paint("dim", f"  ▶ {fit(cur.get('subject'), width - 20)}") if cur else ""))
    if out[-1] != "":
        out.append("")
    out.append(rule)

    # ── then: Implement's summary, the stack, the design
    def field(name, text, r="dim"):
        out.append("  " + paint("dim", f"{name:<10} ") + paint(r, fit(text, width - 15)))
    bits = []
    if t.get("tasks_total"):
        bits.append(f"{t.get('tasks_done') or 0}/{t['tasks_total']} tasks")
    if t.get("checkpoints_total"):
        bits.append(f"{t.get('checkpoints_done') or 0}/{t['checkpoints_total']} checkpoints")
    if t.get("checkpoint"):
        bits.append("now: " + t["checkpoint"])
    if bits:
        field("IMPLEMENT", " · ".join(bits))
    stk, why = stack_line(e)
    if stk:
        out.append("  " + paint("dim", f"{'STACK':<10} ") + paint({"live": "green", "starting": "yellow"}.get(stk, "dim"), stk)
                   + paint("dim", " · " + fit(why, width - 22)))
    d = newest_design(e)
    if d:
        out.append("  " + paint("dim", f"{'DESIGN':<10} ") + paint("accent", fit(d.get("title") or "", width - 32))
                   + paint("dim", "  v open · y copy"))
        out.append("  " + paint("dim", " " * 11 + fit(d["url"], width - 15)))
    out.append("  " + paint("dim", f"{'PANE':<10} {(e.get('tmux') or {}).get('pane') or '-'} · {e.get('model') or ''}"))
    print("\n".join(out))


def checklist_lines(e, paint, width):
    out = []
    tc = (e.get("_ctx") or {}).get("tc") or {}
    folder, slug = tc.get("folder"), tc.get("slug")
    path = Path(folder) / f"TASK_CHECKLIST_{slug}.md" if folder and slug else None
    if path and path.exists():
        out.append(paint("accent", f"  {path.name}", bold=True))
        for ln in path.read_text(errors="replace").splitlines():
            if ln.startswith("## Checkpoint"):
                out.append("  " + paint("text", fit(ln[3:], width - 4), bold=True))
            elif re.match(r"^(###|\s*-) \[[xX]\]", ln):
                out.append("    " + paint("green", "✓ ") + paint("dim", fit(re.sub(r"^(###|\s*-) \[[xX]\]\s*", "", ln), width - 8)))
            elif re.match(r"^(###|\s*-) \[ \]", ln):
                out.append("    " + paint("text", "· " + fit(re.sub(r"^(###|\s*-) \[ \]\s*", "", ln), width - 8)))
        out.append("")
    tasks = e.get("tasks") or []
    if tasks:
        out.append(paint("accent", "  Claude's tasks", bold=True))
        for x in tasks:
            st = x.get("status")
            g, r = {"completed": ("✓", "green"), "in_progress": ("▶", "yellow")}.get(st, ("·", "text"))
            out.append(f"    {paint(r, g)} {paint('text' if st != 'completed' else 'dim', fit(x.get('subject') or '', width - 8))}")
    if not out:
        out.append(paint("dim", "  no checklist and no tasks for this session"))
    return out


def open_stack_url(key):
    e = find(key)
    ctx = e.get("_ctx") or {}
    if e.get("stack") not in ("live", "starting"):
        die("this worktree's stack is not live")
    urls = stack_urls(ctx.get("project"), ctx.get("main"))
    if not urls:
        die("no URL for the stack")
    detach(["xdg-open", urls[0]])


def open_ticket(key):
    e = find(key)
    n = (e.get("ticket") or {}).get("issue")
    if not n:
        die("no ticket number for this session")
    cwd = e.get("cwd") if e.get("cwd") and os.path.isdir(e["cwd"]) else None
    remote = (e.get("_ctx") or {}).get("remote") or ""
    if TS_REPO.lower() in remote.lower():
        detach(["gh", "issue", "view", str(n), "--web", "-R", TS_REPO], cwd=cwd)
    else:
        detach(["gh", "issue", "view", str(n), "--web"], cwd=cwd)


def stack_press(key):
    key = norm_key(key)
    mode, mkey = get_mode()
    if mode == "stack" and mkey == key:
        e = find(key)
        tree, _p, _l, live = stack_plan(e)
        if tree and not live:
            CACHE.mkdir(parents=True, exist_ok=True)
            with open(CACHE / f"stack-{key}.log", "w") as log:
                subprocess.run(["wt-dev", "use", tree, "--db", "auto", "--no-wait"],
                               stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
            try:
                (CACHE / "wt-status.json").unlink()
            except OSError:
                pass
        set_mode("stacked", key)
    else:
        set_mode("stack", key)


def toggle_mode(mode, key):
    key = norm_key(key)
    cur, ckey = get_mode()
    set_mode("" if (cur, ckey) == (mode, key) else mode, key)


def cmd_roster(_args):
    if not shutil.which("fzf"):
        die("fzf is not installed")
    set_mode("")
    t = theme()
    colors = t["fzf"] or ("bg+:#1b1f27,bg:#0a0b0e,fg:#d8dee9,fg+:#eceff4,hl:#88c0d0,hl+:#88c0d0,"
                          "border:#88c0d0,label:#88c0d0,gutter:#0a0b0e,prompt:#81a1c1,pointer:#b48ead,"
                          "marker:#a3be8c,info:#60697d,header:#6c7a96,spinner:#81a1c1")
    me = os.path.realpath(sys.argv[0])
    b = shlex.quote(me)
    letters = "j,k,s,v,y,o,t,c,?,/,1,2,3,4,5,6,7,8,9"
    rows = subprocess.run([me, "__rows"], capture_output=True, text=True).stdout
    binds = [
        "j:down", "k:up", "tab:down", "btab:up",
        f"enter:become({b} jump {{1}})",
        f"s:execute-silent({b} __stack-press {{1}})+refresh-preview",
        f"v:execute-silent({b} design {{1}})",
        f"y:execute-silent({b} design {{1}} --copy)",
        f"o:execute-silent({b} __open-url {{1}})",
        f"t:execute-silent({b} __ticket {{1}})",
        f"c:execute-silent({b} __mode checklist {{1}})+refresh-preview",
        f"?:execute-silent({b} __mode keys {{1}})+refresh-preview",
        f"/:show-input+unbind({letters})",
        # clear-query has to sit outside the transform: from inside one it clears the
        # query without re-filtering the list
        f"esc:clear-query+transform:[ \"$FZF_INPUT_STATE\" = hidden ] && echo abort || echo 'hide-input+rebind({letters})'",
        f"every(3):reload({b} __rows)",
    ] + [f"{n}:execute-silent({b} answer {{1}} {n})+reload({b} __rows)" for n in range(1, 10)]
    cmd = [
        "fzf", "--ansi", "--no-sort", "--reverse", "--height", "100%",
        "--border=rounded", "--border-label", " \uf0ae  board ",       # U+F0AE tasks
        "--prompt", " \uf002  ", "--pointer", "\uf0da", "--color", colors,  # magnifier, caret
        "--delimiter", "\t", "--with-nth", "2..", "--id-nth", "1", "--track",
        "--no-input", "--with-shell", "bash -c",
        "--header", "⏎ jump · 1-9 answer · s s stack · v y design · o open · t ticket · c checklist · / filter · ? keys",
        "--preview", f"{b} __preview {{1}}",
        "--preview-window", "right:50%,border-left,wrap",
    ]
    for bd in binds:
        cmd += ["--bind", bd]
    r = subprocess.run(cmd, input=rows, text=True)
    set_mode("")
    sys.exit(0 if r.returncode in (0, 1, 130) else r.returncode)


# ── dispatch ─────────────────────────────────────────────────────────────────────
def main():
    argv = sys.argv[1:]
    cmd, args = (argv[0], argv[1:]) if argv else ("list", [])
    table = {
        "list": cmd_list, "ls": cmd_list,
        "summary": cmd_summary, "pill": cmd_pill, "roster": cmd_roster,
        "here": cmd_here, "pipelines": cmd_pipelines,
        "jump": cmd_jump, "next": cmd_next, "answer": cmd_answer,
        "stack": cmd_stack, "design": cmd_design, "seen": cmd_seen, "keys": cmd_keys,
        # roster internals
        "__rows": lambda a: roster_rows(),
        "__preview": lambda a: preview(a[0] if a else ""),
        "__stack-press": lambda a: stack_press(a[0]),
        "__mode": lambda a: toggle_mode(a[0], a[1]),
        "__open-url": lambda a: open_stack_url(a[0]),
        "__ticket": lambda a: open_ticket(a[0]),
    }
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    if cmd not in table:
        die(f"unknown command {cmd} (try board --help)")
    table[cmd](args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
    except KeyboardInterrupt:
        sys.exit(130)
