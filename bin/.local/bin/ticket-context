#!/bin/bash
# ticket-context — resolve what a pipeline working tree is actually doing.
#
# Usage:  ticket-context <dir|session-name>
#
# Emits shell-sourceable `key=value` lines (values single-quote escaped). Keys that
# cannot be resolved are simply omitted, so every consumer must tolerate a blank.
#
#   dir root branch pipeline slug issue title problem folder
#   stage stage_index stage_total stage_labels
#   tasks_done tasks_total checkpoints_done checkpoints_total checkpoint
#   dirty commits
#
# Two pipelines, each with its own stage table, transcribed from its orchestrator's
# "Detect the next stage" — the pipeline's own log is the evidence, so this reads
# what the orchestrator reads rather than keeping a second state file that could
# disagree with it:
#
#   pipeline=frontend  travel-smart's frontend-pipeline (`<type>/frontend/<slug>`,
#                      ticket folder Docs/Frontend/tasks/<slug>/)
#   pipeline=pa        personal-assistant's pipeline (`pa-<n>` worktree, branch
#                      `<n>-<slug>`, stage log docs/tasks/<n>-<slug>/NOTES.md, the
#                      plan's `## Checkpoints` in the GitHub issue)
#
# `stage` is the stage's skill name; `stage_labels` the six short labels the
# displays draw (comma-separated, `stage_index` counts from 1 into them).
#
# Consumers: board (the agent board's `ticket`, cached 30 s per worktree), sesh-preview
# (the picker's ticket card), ticket-pill and ticket-window (the ticket window's stage
# line and plan summary). sesh-list-bells never calls it per row; it gets the board's
# cached view in one `board list --json`.

set -u

arg="${1:-$PWD}"
dir=""

# A tmux session name resolves to the working directory of its `claude` window
# (falling back to the first window). tmux 3.7's `#{session_path}` is empty, so
# the pane path is the only reliable source.
if tmux has-session -t "=$arg" 2>/dev/null; then
    dir="$(tmux list-windows -t "=$arg" -F '#{window_name}#{pane_current_path}' 2>/dev/null \
           | sed -n 's/^claude//p' | head -1)"
    [ -z "$dir" ] && dir="$(tmux list-windows -t "=$arg" -F '#{pane_current_path}' 2>/dev/null | head -1)"
elif [ -d "$arg" ]; then
    dir="$arg"
fi

[ -z "$dir" ] || [ ! -d "$dir" ] && exit 0

emit() { [ -n "${2:-}" ] && printf "%s='%s'\n" "$1" "$(printf '%s' "$2" | sed "s/'/'\\\\''/g")"; }

emit dir "$dir"

root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || exit 0
emit root "$root"

branch="$(git -C "$dir" branch --show-current 2>/dev/null)"
emit branch "$branch"

# --- Working-tree state (both pipelines; emitted last) ---------------------------
tree_state() {
    emit dirty "$(git -C "$dir" status --porcelain 2>/dev/null | grep -c .)"
    local base
    base="$(git -C "$dir" rev-parse --verify -q "$1" 2>/dev/null)"
    [ -n "$base" ] && emit commits "$(git -C "$dir" rev-list --count "$1..HEAD" 2>/dev/null)"
}

# --- personal-assistant: pa-<n> ------------------------------------------------
# A tree is on this pipeline when it has the stage-log folder (docs/tasks/) and
# either sits in a `pa-<n>` worktree or is on an `<n>-<slug>` branch. Before
# refinement the worktree is detached at origin/main, so the folder name is the
# only thing that carries the issue number.
pa_issue=""
if [ -d "$root/docs/tasks" ]; then
    if [[ "$branch" =~ ^([0-9]+)-. ]]; then
        pa_issue="${BASH_REMATCH[1]}"
    elif [[ "$(basename "$root")" =~ ^pa-([0-9]+)$ ]]; then
        pa_issue="${BASH_REMATCH[1]}"
    fi
fi

# The issue holds the plan (title, `## Goal`, `## Checkpoints`), so it comes from gh:
# cached per repo + issue for 60 s, and refreshed in the background once stale so a
# caller (tmux's status line, board) never waits on the network after the first read.
PA_TTL=60
pa_fetch() {  # <cache file> — write title/goal/checkpoint lines, or leave it alone
    local json body tmp="$1.$$"
    json="$(cd "$dir" && timeout 4 gh issue view "$pa_issue" --json title,body 2>/dev/null)" || { touch "$1"; return; }
    body="$(printf '%s' "$json" | jq -r '.body // ""')"
    {
        printf 'title\t%s\n' "$(printf '%s' "$json" | jq -r '.title // ""')"
        # The Goal's first sentence: what the issue is for, in one line.
        printf 'goal\t%s\n' "$(printf '%s\n' "$body" | awk '/^## /{on=($0 ~ /^## Goal/); next} on && NF {print; exit}' \
            | sed -E 's/\*\*?//g; s/`//g; s/\[([^]]*)\]\([^)]*\)/\1/g; s/([.!?])[[:space:]].*/\1/' \
            | awk '{ if (length($0) > 160) { s = substr($0, 1, 160); sub(/[[:space:],;:(]+[^[:space:]]*$/, "", s); $0 = s "…" } print }')"
        # Checkpoint lines: `- [x] **1 — Registry: …** · commit: …` → `x<TAB>1 — Registry: …`
        printf '%s\n' "$body" | awk '/^## /{on=($0 ~ /^## Checkpoints/); next} on' \
            | sed -nE 's/^- \[([ xX])\] \*\*([^*]+)\*\*.*/cp\t\1\t\2/p'
    } > "$tmp" && mv "$tmp" "$1"
}

pa_context() {
    emit pipeline pa
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/ticket-context"
    local key cache age
    key="$(git -C "$dir" remote get-url origin 2>/dev/null | sed -E 's#^.*[:/]([^/]+/[^/]+)$#\1#; s#\.git$##; s#/#_#g')"
    cache="$cache_dir/${key:-local}-$pa_issue"
    mkdir -p "$cache_dir"
    if [ ! -f "$cache" ]; then
        pa_fetch "$cache"
    else
        age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
        if [ "$age" -ge "$PA_TTL" ] && mkdir "$cache.lock" 2>/dev/null; then
            ( touch "$cache"; pa_fetch "$cache"; rmdir "$cache.lock" ) </dev/null >/dev/null 2>&1 &
            disown
        fi
    fi

    local title="" goal="" cp_done=0 cp_total=0 checkpoint="" known=""
    if [ -s "$cache" ]; then
        known=1
        while IFS=$'\t' read -r k a b; do
            case "$k" in
                title) title="$a" ;;
                goal)  goal="$a" ;;
                cp)    cp_total=$((cp_total + 1))
                       if [ "$a" = " " ]; then [ -z "$checkpoint" ] && checkpoint="$b"
                       else cp_done=$((cp_done + 1)); fi ;;
            esac
        done < "$cache"
    fi

    local slug="" folder="" notes=""
    [[ "$branch" =~ ^[0-9]+- ]] && slug="$branch"
    emit slug "$slug"
    if [ -n "$slug" ] && [ -d "$root/docs/tasks/$slug" ]; then
        folder="$root/docs/tasks/$slug"
        [ -f "$folder/NOTES.md" ] && notes="$folder/NOTES.md"
    fi
    emit folder "$folder"
    emit issue "$pa_issue"
    emit title "$title"
    emit problem "${goal:-$title}"

    has() { [ -n "$notes" ] && grep -qE "^## $1" "$notes" 2>/dev/null; }
    # pipeline/SKILL.md, "Detect the next stage". With the issue unreadable (gh down,
    # first fetch failed) the checkpoints are unknown: a branch means refinement is
    # over (implement-plan cuts it), no branch means it hasn't happened.
    local stage stage_index
    if { [ -n "$known" ] && [ "$cp_total" -eq 0 ]; } || { [ -z "$known" ] && [ -z "$slug" ]; }; then
        stage="refine-issue";   stage_index=1
    elif [ "$cp_done" -lt "$cp_total" ] || ! has 'Implementation'; then
        stage="implement-plan"; stage_index=2
    elif ! has 'Review'; then
        stage="self-review";    stage_index=3
    elif ! has 'Doc drift'; then
        stage="doc-drift";      stage_index=4
    elif ! has 'Self verification'; then
        stage="self-verify";    stage_index=5
    else
        stage="raise-pr";       stage_index=6
    fi
    emit stage "$stage"
    emit stage_index "$stage_index"
    emit stage_total 6
    emit stage_labels "Refine,Implement,Review,Docs,Verify,PR"
    if [ "$cp_total" -gt 0 ]; then
        emit checkpoints_done "$cp_done"
        emit checkpoints_total "$cp_total"
        # the one being built; with every box ticked, nothing is
        emit checkpoint "$checkpoint"
    fi
    tree_state origin/main
}

if [ -n "$pa_issue" ]; then
    pa_context
    exit 0
fi

# --- travel-smart: the frontend pipeline -----------------------------------------

# Branch format is `<type>/frontend/<slug>`; the slug is what names the ticket
# folder. A detached HEAD or a placeholder branch (`issue-42`) yields no slug,
# which is itself the signal that planning has not run yet.
slug=""
case "$branch" in
    */frontend/*) slug="${branch##*/frontend/}" ;;
esac
emit slug "$slug"

folder="" checklist="" notes=""
if [ -n "$slug" ] && [ -d "$root/Docs/Frontend/tasks/$slug" ]; then
    folder="$root/Docs/Frontend/tasks/$slug"
    [ -f "$folder/TASK_CHECKLIST_$slug.md" ] && checklist="$folder/TASK_CHECKLIST_$slug.md"
    [ -f "$folder/NOTES_$slug.md" ] && notes="$folder/NOTES_$slug.md"
fi
emit folder "$folder"

# --- The one-line description --------------------------------------------------
# The checklist's H1 is written as `# Task Checklist — <what this ticket is>`;
# everything before the dash is boilerplate, so only the tail is worth showing.
title="" issue=""
if [ -n "$checklist" ]; then
    title="$(head -1 "$checklist" | sed -E 's/^#+[[:space:]]*//; s/^Task Checklist[[:space:]]*[—-][[:space:]]*//')"
    issue="$(grep -m1 -oE '^Issue:[[:space:]]*#[0-9]+' "$checklist" 2>/dev/null | grep -oE '[0-9]+')"
fi
# No checklist yet: the issue title from the snapshot ticket-window took when the
# session started, so a ticket still in planning (or parked on a planning question)
# has a name on every card instead of a blank. `problem` falls through to it below.
if [ -z "$title" ]; then
    meta="$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null)/ticket.meta"
    if [ -f "$meta" ]; then
        title="$(sed -n 's/^title=//p' "$meta" | head -1)"
        [ -z "$issue" ] && issue="$(sed -n 's/^issue=//p' "$meta" | head -1)"
    fi
fi
# Fall back to the session/worktree name (`issue-830`) when there is no checklist yet.
[ -z "$issue" ] && issue="$(printf '%s' "$dir" | grep -oE 'issue-[0-9]+' | head -1 | grep -oE '[0-9]+')"
emit issue "$issue"
emit title "$title"
# Any git dir gets this far (and the stage table below calls it start-ticket), so
# only a tree that names a ticket is on the pipeline.
{ [ -n "$slug" ] || [ -n "$issue" ]; } && emit pipeline frontend

# --- The problem one-liner ------------------------------------------------------
# What the ticket is FOR, in one sentence. `title` names the feature — "South
# African money formatting" — which is only ever a reminder if you already
# remember the ticket; coming back to a session cold, what you need is the thing
# that is wrong. Three sources, in descending order of how deliberately each was
# written as a problem statement:
#
#   1. `Problem: <one line>` — written by frontend-start-ticket. The only one of
#      the three that is a problem statement by construction.
#   2. the `Issue:` line's title — the GitHub issue title, which usually names the
#      symptom. This is what every checklist written before the `Problem:` line
#      existed falls back to, which is why none of them needed backfilling.
#   3. `title`. Names the feature rather than the problem, but beats a blank.
problem=""
if [ -n "$checklist" ]; then
    problem="$(grep -m1 -E '^Problem:' "$checklist" 2>/dev/null | sed -E 's/^Problem:[[:space:]]*//')"
    # `Issue: #844 — <title> (<url>)` -> `<title>`. Each piece is stripped by its
    # own expression because the older checklists in the tree write the line as
    # `Issue(s): #252 <title>` with no dash and no URL, and both shapes have to
    # land on the same answer.
    # The `#<n>` is required, not incidental: a ticket with no GitHub issue writes
    # the line as `Issue: none — handed over in session`, and the tail of that is
    # bookkeeping about the ticket's provenance rather than anything about the work.
    [ -z "$problem" ] && problem="$(grep -m1 -E '^Issue(\(s\))?:[[:space:]]*#[0-9]+' "$checklist" 2>/dev/null \
        | sed -E 's/^Issue(\(s\))?:[[:space:]]*//; s/^#[0-9]+[[:space:]]*[—–-]?[[:space:]]*//; s/[[:space:]]*\(https?:[^)]*\)[[:space:]]*$//')"
fi
[ -z "$problem" ] && problem="$title"
emit problem "$problem"

# --- Where in the pipeline ------------------------------------------------------
# NOTES section headings are the stage log: each stage appends its own. Match on
# prefix, because a heading may carry a suffix (`## Implementation — Part 2 (#558)`).
has() { [ -n "$notes" ] && grep -qE "^## $1" "$notes" 2>/dev/null; }

stage="" stage_index=0
if [ -z "$slug" ] || [ -z "$checklist" ]; then
    stage="start-ticket";       stage_index=1
elif ! has 'Implementation'; then
    stage="implement-plan";     stage_index=2
elif ! has 'Review'; then
    stage="review";             stage_index=3
elif ! has 'Doc drift'; then
    stage="doc-drift";          stage_index=4
elif ! has 'Human verification'; then
    stage="human-verification"; stage_index=5
else
    stage="raise-pr";           stage_index=6
fi
emit stage "$stage"
emit stage_index "$stage_index"
emit stage_total 6
emit stage_labels "Start,Implement,Review,Docs,Verify,PR"

# --- Checklist progress ---------------------------------------------------------
# Two formats are in the wild: the current pipeline writes tasks as `### [x] 1.1 — …`
# headings, older checklists as plain `- [x]` bullets. Prefer the heading form when
# present: the bullet form is also used for non-task notes (gap lists, findings),
# so counting it on a heading-style checklist would inflate the total.
if [ -n "$checklist" ]; then
    done_n="$(grep -cE '^### \[[xX]\]' "$checklist" 2>/dev/null)"
    open_n="$(grep -cE '^### \[ \]' "$checklist" 2>/dev/null)"
    if [ "$((done_n + open_n))" -eq 0 ]; then
        done_n="$(grep -cE '^[[:space:]]*- \[[xX]\]' "$checklist" 2>/dev/null)"
        open_n="$(grep -cE '^[[:space:]]*- \[ \]' "$checklist" 2>/dev/null)"
    fi
    emit tasks_done "$done_n"
    emit tasks_total "$((done_n + open_n))"

    # The active checkpoint is the one holding the first still-unchecked task; with
    # none unchecked, the last checkpoint in the file.
    # Only boxes inside a checkpoint count: the brief and acceptance sections above
    # the first checkpoint carry `- [ ]` lists of their own.
    cp="$(awk '
        /^## Checkpoint/ { in_cp = 1; last = $0; next }
        /^## /           { in_cp = 0; next }
        in_cp && /^(### \[ \]|[[:space:]]*- \[ \])/ { print last; found = 1; exit }
        END { if (!found) print last }' "$checklist" 2>/dev/null)"
    # Drop the `· commit: \`…\`` tail — it is instruction, not status.
    emit checkpoint "$(printf '%s' "$cp" | sed -E 's/^#+[[:space:]]*//; s/[[:space:]]*·[[:space:]]*commit:.*$//')"

    # Checkpoints: a `## Checkpoint` section is done once no task in it is open.
    read -r cps_done cps_total < <(awk '
        function flush() { if (in_cp) d += !open }
        /^## Checkpoint/ { flush(); in_cp = 1; n++; open = 0; next }
        /^## /           { flush(); in_cp = 0; next }
        in_cp && /^(### \[ \]|[[:space:]]*- \[ \])/ { open = 1 }
        END { flush(); print d + 0, n + 0 }' "$checklist")
    if [ "${cps_total:-0}" -gt 0 ]; then
        emit checkpoints_done "$cps_done"
        emit checkpoints_total "$cps_total"
    fi
fi

tree_state origin/develop

exit 0
