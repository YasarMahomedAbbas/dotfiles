#!/bin/bash
# Preview for the sesh picker (bin/sesh-picker).
# Arg $1 = the raw fzf line: "<ansi><icon><ansi> <name-or-path>".
#
#  - running tmux session  -> its window list + a live capture of the active pane
#  - a directory           -> a file tree (eza)
#  - anything else         -> sesh's own preview, on the cleaned name

raw="$1"

# Clean the raw fzf line to the bare name (strips ANSI, the leading icon glyph,
# and the trailing Claude status glyph sesh-list-bells appends); otherwise it
# leaks into the name and every check below (has-session, -d) fails, falling
# through to an empty generic preview. That glyph is the whole reason you're
# previewing. Shared helper so this can't drift from sesh-list-bells/sesh-picker.
name="$(sesh-clean-name "$raw")"

C_ACCENT='\033[38;2;136;192;208m'   # frost cyan
C_DIM='\033[38;2;76;86;106m'        # nord3
C_RESET='\033[0m'

# 1) Running tmux session → window list + active pane
if tmux has-session -t "=$name" 2>/dev/null; then
    printf "${C_ACCENT}  %s${C_RESET}\n\n" "$name"
    # tmux -F can't emit terminal colours, so colour the rows in the shell
    tmux list-windows -t "=$name" \
        -F '#{window_index}:#{window_name}:#{window_panes}:#{window_active}:#{window_zoomed_flag}' \
    | while IFS=: read -r idx wname panes active zoomed; do
        z=""; [ "$zoomed" = 1 ] && z=" [Z]"
        if [ "$active" = 1 ]; then
            printf "  ${C_ACCENT}%s: %s%s *${C_RESET}  ${C_DIM}%sp${C_RESET}\n" "$idx" "$wname" "$z" "$panes"
        else
            printf "  ${C_DIM}%s: %s  %sp${C_RESET}\n" "$idx" "$wname" "$panes"
        fi
    done
    # If Claude flagged a specific pane, preview THAT pane — exactly what it is
    # showing / asking for / working in — taking the tail so a prompt or live
    # output at the bottom is visible. @claude_alert (Stop/PermissionRequest:
    # done or waiting) takes priority over @claude_busy (working); they're
    # mutually exclusive in practice. Otherwise fall back to the active pane.
    #
    # pane_here filters panes the hooks misattributed to another session (see
    # sesh-list-bells): the flagged pane must actually live in THIS session,
    # else we'd preview an unrelated session's Claude and label it as this one's.
    pane_here() { [ -n "$1" ] && [ "$(tmux display-message -p -t "$1" '#{session_name}' 2>/dev/null)" = "$name" ]; }
    alert_pane="$(tmux show-options -t "$name" -qv @claude_alert 2>/dev/null)"
    busy_pane="$(tmux show-options -t "$name" -qv @claude_busy 2>/dev/null)"
    if pane_here "$alert_pane" && tmux capture-pane -p -t "$alert_pane" >/dev/null 2>&1; then
        printf "\n${C_ACCENT}  ──  Claude · needs attention ──${C_RESET}\n"
        tmux capture-pane -ep -t "$alert_pane" 2>/dev/null | sed -e 's/[[:space:]]*$//; s/^/  /' | tail -30
    elif pane_here "$busy_pane" && tmux capture-pane -p -t "$busy_pane" >/dev/null 2>&1; then
        printf "\n${C_ACCENT}  ──  Claude · working… ──${C_RESET}\n"
        tmux capture-pane -ep -t "$busy_pane" 2>/dev/null | sed -e 's/[[:space:]]*$//; s/^/  /' | tail -30
    else
        printf "\n${C_DIM}  ── active pane ──${C_RESET}\n"
        active="$(tmux list-windows -t "=$name" -F '#{window_index}:#{window_active}' | awk -F: '$2==1{print $1; exit}')"
        tmux capture-pane -ep -t "=$name:$active" 2>/dev/null | sed -e 's/[[:space:]]*$//; s/^/  /' | head -30
    fi
    exit 0
fi

# 2) A real directory → file tree
if [ -d "$name" ]; then
    eza --tree --level=2 --icons --color=always --group-directories-first "$name" 2>/dev/null | head -60
    exit 0
fi

# 3) Fall back to sesh's own preview, with the cleaned name
sesh preview "$name" 2>/dev/null
