#!/bin/bash
# Preview for the sesh picker (bin/sesh-picker).
# Arg $1 = the raw fzf line: "<ansi><icon><ansi> <name>  <status>".
#
#   - a running tmux session on a frontend-pipeline ticket -> a ticket card:
#     the problem being solved, on which branch, where it is in the pipeline, how
#     far through the checklist, and only then a short tail of Claude's pane
#   - any other running session -> branch + working-tree state + windows + pane
#   - a directory                -> a file tree (eza)
#   - anything else              -> sesh's own preview
#
# The card comes first on purpose. A raw pane capture answers "what did Claude
# just print", which is the wrong question when you are scanning six sessions for
# the one that needs you — you want the ticket, the stage and whether it is stuck.
# The pane tail is kept, last and short, because when a session IS parked on a
# question that question is in it.

raw="$1"
name="$(sesh-clean-name "$raw")"

# Colours follow the active theme (~/.config/theme/sesh-colors.sh, rendered by
# theme-switch), falling back to dark-nord so the preview still renders on a machine
# where theme-switch has never run.
# shellcheck disable=SC1090
[ -r "$HOME/.config/theme/sesh-colors.sh" ] && . "$HOME/.config/theme/sesh-colors.sh"
rgb() { printf '\033[38;2;%d;%d;%dm' "$((16#${1:0:2}))" "$((16#${1:2:2}))" "$((16#${1:4:2}))"; }
C_ACCENT="$(rgb "${SESH_ACCENT_COLOR:-88c0d0}")"
C_DIM="$(rgb "${SESH_DIM_COLOR:-4c566a}")"
C_TEXT="$(rgb "${SESH_TEXT_COLOR:-d8dee9}")"
C_OK="$(rgb "${SESH_OK_COLOR:-a3be8c}")"
C_WARN="$(rgb "${SESH_BUSY_COLOR:-ebcb8b}")"
C_ALERT="$(rgb "${SESH_ATTN_COLOR:-e0703a}")"
fzfc() { printf '%s' "${SESH_FZF_COLORS:-}" | tr ',' '\n' | sed -n "s/^$1:#//p" | head -1; }
h_fg0="${SESH_FG0_COLOR:-$(fzfc 'fg+')}";   C_FG0="$(rgb "${h_fg0:-eceff4}")"
h_blue="${SESH_BLUE_COLOR:-$(fzfc prompt)}"; C_BLUE="$(rgb "${h_blue:-81a1c1}")"
C_RESET=$'\033[0m'

rule() { printf "${C_DIM}  %s${C_RESET}\n" "────────────────────────────────────────────"; }

# ---------------------------------------------------------------- running session
if tmux has-session -t "=$name" 2>/dev/null; then

    # Status, from the agent board (`board list --json`, docs/agent-board.md) — the
    # same source sesh-list-bells reads. The first entry for this session is its most
    # urgent Claude (board sorts needs_you > working > background > unseen > idle).
    # Tab-separated: state, banner text, pane, then the question and its options.
    board_line="$(board list --json 2>/dev/null | jq -r --arg s "$name" --argjson now "$(date +%s%3N)" '
      def el: (. / 1000 | floor) as $x
        | if $x < 60 then "\($x)s" elif $x < 3600 then "\($x / 60 | floor)m" else "\($x / 3600 | floor)h\(($x % 3600) / 60 | floor)m" end;
      [.[] | select(.tmux.session == $s)] | first // empty
      | (if .stale then "stale"
         elif .state == "working" and ((.current.typical_ms // 0) > 0)
              and ($now - (.current.started // $now)) > .current.typical_ms then "slow"
         elif .state == "idle" and .unseen then "unseen" else .state end) as $st
      | (if .stale then "stale · Claude is gone"
         elif .state == "needs_you" then "needs you · \(.attention.title // .attention.kind // "?")"
         elif .state == "working" then "working · \(.current.detail // .current.tool // "turn in progress") \(($now - (.current.started // .since // $now)) | el)\(if $st == "slow" then " · slow" else "" end)"
         elif .state == "background" then "background · \([.agents[]? | select(.status == "running")] | length) agents · \([.shells[]? | select(.status == "running")] | length) shells"
         elif .unseen then "done · unseen"
         else "idle" end) as $banner
      | [$st, $banner, (.tmux.pane // ""), (.attention.text // ""),
         ([.attention.options[]? | "\(.key)  \(.label)"] | join("\u001f"))] | @tsv' 2>/dev/null)"
    bstate="" banner="" hpane="" question="" options=""
    [ -n "$board_line" ] && IFS=$'\t' read -r bstate banner hpane question options <<< "$board_line"

    case "$bstate" in
        needs_you) bcol="$C_ALERT" ;;
        working)   bcol="$C_FG0" ;;
        slow)      bcol="$C_WARN" ;;
        background) bcol="$C_BLUE" ;;
        unseen)    bcol="$C_OK" ;;
        *)         bcol="$C_DIM" ;;
    esac
    [ "$bstate" = "idle" ] && banner=""

    printf "${C_ACCENT}  %s${C_RESET}" "$name"
    [ -n "$banner" ] && printf "   ${bcol}%s${C_RESET}" "$banner"
    printf "\n\n"

    # The question Claude is blocked on, and what 1..9 would answer (board answer).
    if [ "$bstate" = "needs_you" ] && [ -n "$question" ]; then
        printf '%s\n' "$question" | fold -s -w 70 | sed -e "s/^/  /" -e "s/^/$(printf '%s' "$C_TEXT")/" -e "s/\$/$(printf '%s' "$C_RESET")/"
        if [ -n "$options" ]; then
            printf '%s\n' "$options" | tr '\037' '\n' | while IFS= read -r o; do
                printf "    ${C_ALERT}%s${C_RESET}\n" "$o"
            done
        fi
        printf "\n"
    fi

    # ------------------------------------------------------------- the ticket card
    dir="" root="" branch="" pipeline="" slug="" issue="" title="" problem="" stage="" stage_index=""
    stage_labels=""
    tasks_done="" tasks_total="" checkpoint="" dirty="" commits=""
    eval "$(ticket-context "$name" 2>/dev/null)"

    if [ -n "$branch" ] || [ -n "$pipeline" ]; then
        # The headline is `problem`, not `title`. Scanning six sessions, the feature's
        # name ("South African money formatting") only helps if you already remember
        # the ticket; what you came here for is the thing that is wrong. `title` is not
        # printed as well — it is the branch slug in prose, and the branch is the very
        # next line.
        if [ -n "$problem" ]; then
            printf "  ${C_ACCENT}%s${C_RESET}  ${C_TEXT}%s${C_RESET}\n" \
                "${issue:+#$issue}" "$problem"
        elif [ -n "$issue" ]; then
            printf "  ${C_ACCENT}#%s${C_RESET}\n" "$issue"
        fi
        printf "  ${C_DIM}%s${C_RESET}\n" "${branch:-detached}"

        line=""
        [ -n "$commits" ] && [ "$commits" != "0" ] && line="$commits commit(s) ahead of $([ "$pipeline" = pa ] && echo main || echo develop)"
        if [ -n "$dirty" ] && [ "$dirty" != "0" ]; then
            line="${line:+$line · }$dirty file(s) uncommitted"
        fi
        [ -n "$line" ] && printf "  ${C_DIM}%s${C_RESET}\n" "$line"
        printf "\n"

        # --------------------------------------------------------- the stage rail
        # Only on a pipeline (ticket-context names which); otherwise every session
        # would read as "stage 1" whether or not it is on one at all.
        if [ -n "$pipeline" ]; then
            printf "  ${C_DIM}pipeline${C_RESET}  "
            i=1
            IFS=, read -ra labels <<< "${stage_labels:-Start,Implement,Review,Docs,Verify,PR}"
            for s in "${labels[@]}"; do
                if   [ "$i" -lt "${stage_index:-0}" ]; then printf "${C_OK}✓ %s${C_RESET}  " "$s"
                elif [ "$i" -eq "${stage_index:-0}" ]; then printf "${C_WARN}▶ %s${C_RESET}  " "$s"
                else                                        printf "${C_DIM}· %s${C_RESET}  " "$s"
                fi
                i=$((i + 1))
            done
            printf "\n"
        fi

        [ -n "$checkpoint" ] && printf "  ${C_TEXT}%s${C_RESET}\n" "$checkpoint"

        if [ -n "$tasks_total" ] && [ "$tasks_total" -gt 0 ] 2>/dev/null; then
            width=24
            filled=$(( tasks_done * width / tasks_total ))
            bar=""
            i=0; while [ "$i" -lt "$width" ]; do
                if [ "$i" -lt "$filled" ]; then bar="$bar█"; else bar="$bar░"; fi
                i=$((i + 1))
            done
            printf "  ${C_DIM}tasks${C_RESET}     ${C_OK}%s${C_RESET} ${C_DIM}%s/%s${C_RESET}\n" \
                "$bar" "$tasks_done" "$tasks_total"
        fi
        printf "\n"
    fi

    # ------------------------------------------------------------------- windows
    tmux list-windows -t "=$name" \
        -F '#{window_index}:#{window_name}:#{window_panes}:#{window_active}:#{window_zoomed_flag}' \
    | while IFS=: read -r idx wname panes active zoomed; do
        z=""; [ "$zoomed" = 1 ] && z=" [Z]"
        if [ "$active" = 1 ]; then
            printf "  ${C_ACCENT}%s: %s%s *${C_RESET}  ${C_DIM}%sp${C_RESET}\n" "$idx" "$wname" "$z" "$panes"
        else
            printf "  ${C_DIM}%s: %s  %sp${C_RESET}\n" "$idx" "$wname" "$panes"
        fi
    done

    # -------------------------------------------------------------- the pane tail
    # Short by design: the card above is the answer to "what is this session", and
    # this is only here for the case where Claude is parked on a question.
    lines=14
    target=""
    if [ -n "$hpane" ] && [ "$(tmux display-message -p -t "$hpane" '#{session_name}' 2>/dev/null)" = "$name" ]; then
        target="$hpane"
    else
        aw="$(tmux list-windows -t "=$name" -F '#{window_index}:#{window_active}' | awk -F: '$2==1{print $1; exit}')"
        target="=$name:$aw"
    fi
    printf "\n"; rule
    tmux capture-pane -ep -t "$target" 2>/dev/null \
        | sed -e 's/[[:space:]]*$//' | grep -v '^$' | tail -"$lines" | sed -e 's/^/  /'
    exit 0
fi

# -------------------------------------------------------------------- a directory
if [ -d "$name" ]; then
    eza --tree --level=2 --icons --color=always --group-directories-first "$name" 2>/dev/null | head -60
    exit 0
fi

sesh preview "$name" 2>/dev/null
