#!/bin/bash
# `sesh list` with a branch column and a Claude / pipeline status column added to
# running tmux sessions:
#
#    issue-559    feat/frontend/quotation-room-description   ● needs you · Results
#    issue-612    feat/frontend/wallet-statement             ▶ pnpm test 3m
#    travelsmart  develop
#    dotfiles
#
#   ● needs you · <title>        rust   — Claude is blocked on you (permission,
#                                         question, plan approval)
#   ▶ <what it runs> <elapsed>    fg0    — a turn is in progress; yellow + "slow"
#                                         once it runs past its typical time
#   ◐ background · N agents       blue   — the turn ended but agents/shells still run
#   ✓ unseen                      green  — finished since you last looked at it
#   (nothing)                            — idle, and you have seen it
#
# The branch is what tells two worktrees of the same project apart, which the session
# name alone often doesn't — `issue-559` says which ticket but not what it became, and
# a detached worktree shows `@<sha>` so a run that hasn't branched yet is obvious.
#
# Status comes from the agent board (`board list --json`, docs/agent-board.md): ONE
# call per render, not per row. A session running several Claudes shows the most
# urgent one — board's own order (needs_you > working > background > unseen > idle).
#
# Row order is FIXED — it never changes when you switch sessions or a Claude changes
# state, so you can find things by position. sesh's own order is most-recently-used,
# which reshuffles the list on every switch, so it is thrown away for tmux rows:
#
#   1. running tmux sessions, ALWAYS above everything else, in the order
#        `sesh-order sort` gives: your manual order (alt-k / alt-j in the picker),
#        then sesh.toml order, then A–Z
#   2. config rows, in sesh.toml order
#   3. zoxide rows, in sesh's order
#
# Status is a column only; it deliberately does not move a row.
#
# All `sesh list` flags pass straight through. Only rows that are genuine tmux
# sessions may be decorated: `sesh list` mixes in config and zoxide rows, and a
# config row shares its live session's name, so a plain name match would decorate
# both twins. Keying off `sesh list -t` (byte-identical rows, sessions only) is what
# keeps the config/zoxide views clean.
#
# Cost note: tmux is asked in two global calls and the board in one, rather than per
# row, and git is asked only about rows that are actually running sessions (a handful,
# not the ~30 config/zoxide rows). This runs on picker open and on the ctrl-a/t/c/x
# reloads — not on every keystroke, since fzf filters in process.

# shellcheck disable=SC1090
[ -r "$HOME/.config/theme/sesh-colors.sh" ] && . "$HOME/.config/theme/sesh-colors.sh"
rgb() { printf '\033[38;2;%d;%d;%dm' "$((16#${1:0:2}))" "$((16#${1:2:2}))" "$((16#${1:4:2}))"; }
fzfc() { printf '%s' "${SESH_FZF_COLORS:-}" | tr ',' '\n' | sed -n "s/^$1:#//p" | head -1; }
C_RED="$(rgb "${SESH_ATTN_COLOR:-e0703a}")"
C_YELLOW="$(rgb "${SESH_BUSY_COLOR:-ebcb8b}")"
C_GREEN="$(rgb "${SESH_OK_COLOR:-a3be8c}")"
C_DIM="$(rgb "${SESH_DIM_COLOR:-4c566a}")"
# fg0 / blue joined sesh-colors.sh with the board; until the next theme-switch they
# come out of the fzf colour string (fg+ is fg0, prompt is blue).
h_fg0="${SESH_FG0_COLOR:-$(fzfc 'fg+')}";   C_FG0="$(rgb "${h_fg0:-eceff4}")"
h_blue="${SESH_BLUE_COLOR:-$(fzfc prompt)}"; C_BLUE="$(rgb "${h_blue:-81a1c1}")"
C_BRANCH="$C_DIM"
C_OFF=$'\033[0m'

# --- Everything tmux and the board know, in three calls ---------------------------
windows_raw="$(tmux list-windows -a -F '#{session_name}|#{window_name}|#{pane_current_path}' 2>/dev/null)"
session_rows="$(sesh list -t --icons 2>/dev/null)"

# One line per Claude: session <TAB> colour role <TAB> status text. jq's @tsv escapes
# any tab or newline in a tool's detail, so a row can never split.
board_raw="$(board list --json 2>/dev/null | jq -r --argjson now "$(date +%s%3N)" '
  def el: (. / 1000 | floor) as $s
    | if $s < 60 then "\($s)s" elif $s < 3600 then "\($s / 60 | floor)m"
      else "\($s / 3600 | floor)h\(($s % 3600) / 60 | floor | tostring | if length < 2 then "0" + . else . end)m" end;
  def plural($n; $w): "\($n) \($w)\(if $n == 1 then "" else "s" end)";
  .[] | select(.tmux.session != null) |
  (if .stale then ["dim", "○ stale"]
   elif .state == "needs_you" then ["red", "● needs you · \(.attention.title // .attention.kind // "?")"]
   elif .state == "working" then
     (.current // {}) as $c | ($now - ($c.started // .since // $now)) as $e
     | (($c.typical_ms // 0) > 0 and $e > $c.typical_ms) as $slow
     | [(if $slow then "yellow" else "fg0" end),
        "▶ \($c.detail // $c.tool // "working") \($e | el)\(if $slow then " slow" else "" end)"]
   elif .state == "background" then
     ([.agents[]? | select(.status == "running" or .status == "needs_you")] | length) as $a
     | ([.shells[]? | select(.status == "running")] | length) as $sh
     | ["blue", "◐ background · \(if $a > 0 or $sh == 0 then plural($a; "agent") else plural($sh; "shell") end)"]
   elif .unseen then ["green", "✓ unseen"]
   else ["", ""] end) as $s
  | [.tmux.session, $s[0], $s[1]] | @tsv' 2>/dev/null)"

# status_for <session> -> the coloured status text, or nothing. board's list is sorted
# most-urgent first, so the first line for a session is the one to show.
status_for() {
    local role text
    IFS=$'\t' read -r _ role text < <(printf '%s\n' "$board_raw" | awk -F'\t' -v s="$1" '$1 == s { print; exit }')
    [ -z "$text" ] && return
    case "$role" in
        red)    printf '%s%s%s' "$C_RED"    "$text" "$C_OFF" ;;
        yellow) printf '%s%s%s' "$C_YELLOW" "$text" "$C_OFF" ;;
        fg0)    printf '%s%s%s' "$C_FG0"    "$text" "$C_OFF" ;;
        blue)   printf '%s%s%s' "$C_BLUE"   "$text" "$C_OFF" ;;
        green)  printf '%s%s%s' "$C_GREEN"  "$text" "$C_OFF" ;;
        *)      printf '%s%s%s' "$C_DIM"    "$text" "$C_OFF" ;;
    esac
}

# branch_for <session> — the checked-out branch of the session's working directory,
# resolved from its `claude` window (falling back to the first): tmux 3.7's
# #{session_path} is empty, so a pane path is the only source. A detached HEAD —
# what a pipeline worktree sits on until start-ticket creates the branch — prints
# as @<short-sha> rather than nothing, so "no branch yet" is visible instead of blank.
branch_for() {
    local s="$1" dir
    dir="$(printf '%s\n' "$windows_raw" | awk -F'|' -v s="$s" '$1 == s && $2 == "claude" { sub(/^[^|]*\|[^|]*\|/, ""); print; exit }')"
    [ -z "$dir" ] && dir="$(printf '%s\n' "$windows_raw" | awk -F'|' -v s="$s" '$1 == s { sub(/^[^|]*\|[^|]*\|/, ""); print; exit }')"
    [ -z "$dir" ] || [ ! -d "$dir" ] && return
    git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null && return
    local sha; sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)" && [ -n "$sha" ] && printf '@%s\n' "$sha"
}

vis() { printf '%s' "$1" | sed -E 's/\x1b\[[0-9;]*m//g'; }

# --- Collect, measuring the two columns as we go --------------------------------
# Running sessions are held as  name \t line \t branch \t status  and padded only once
# the widest name and branch across the whole list are known. Config / zoxide rows
# are never decorated and keep sesh's order, so they are held as-is.
rows=(); others=(); namewidth=0; branchwidth=0
while IFS= read -r line; do
    [ -z "$line" ] && continue
    if ! printf '%s\n' "$session_rows" | grep -qxF -- "$line"; then
        others+=("$line"); continue
    fi
    name="$(sesh-clean-name "$line")"
    branch="$(branch_for "$name")"
    text="$(status_for "$name")"

    v="$(vis "$line")";   [ "${#v}" -gt "$namewidth" ]   && namewidth="${#v}"
    [ "${#branch}" -gt "$branchwidth" ] && branchwidth="${#branch}"
    rows+=("$name"$'\t'"$line"$'\t'"$branch"$'\t'"$text")
done < <(sesh list "$@")

[ "$namewidth"   -gt 30 ] && namewidth=30
[ "$branchwidth" -gt 46 ] && branchwidth=46

if [ "${#rows[@]}" -gt 0 ]; then
    # Join each row back onto its name in `sesh-order sort` order.
    printf '%s\n' "${rows[@]}" | cut -f1 | sesh-order sort |
    while IFS= read -r n; do
        IFS=$'\t' read -r _ line branch text < <(printf '%s\n' "${rows[@]}" | awk -F'\t' -v n="$n" '$1 == n { print; exit }')
        if [ -z "$branch" ] && [ -z "$text" ]; then
            printf '%s\n' "$line"; continue
        fi
        v="$(vis "$line")"
        pad=$(( namewidth - ${#v} + 2 )); [ "$pad" -lt 2 ] && pad=2
        printf '%s%*s' "$line" "$pad" ""
        if [ -n "$text" ]; then
            printf '%s%-*s%s%s\n' "$C_BRANCH" "$branchwidth" "$branch" "$C_OFF" "  $text"
        else
            printf '%s%s%s\n' "$C_BRANCH" "$branch" "$C_OFF"
        fi
    done
fi
[ "${#others[@]}" -gt 0 ] && printf '%s\n' "${others[@]}"
